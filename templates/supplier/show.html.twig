{% extends 'base.html.twig' %}
{% block title %}{{ supplier.name }}{% endblock %}
{% block body %}
<h1 class="page-title h3 mb-3">{{ supplier.name }}</h1>
<div class="card stat-card p-3 mb-3">
    <p class="mb-1"><strong>Tél.</strong> {{ supplier.phone ?: '—' }}</p>
    <p class="mb-1"><strong>Email</strong> {{ supplier.email ?: '—' }}</p>
    <p class="mb-0"><strong>Adresse</strong> {{ supplier.address ?: '—' }}</p>
</div>
<h2 class="h5">Historique des commandes</h2>
<div class="card stat-card">
<table class="table mb-0">
<thead><tr><th>Réf.</th><th>Date</th><th>Statut</th><th>Total</th></tr></thead>
<tbody>
{% for o in supplier.purchaseOrders %}
<tr>
    <td><a href="{{ path('app_purchase_show', {id: o.id}) }}">{{ o.reference }}</a></td>
    <td>{{ o.createdAt|date('d/m/Y') }}</td>
    <td>{{ o.status }}</td>
    <td>{{ o.total|money }}</td>
</tr>
{% else %}
<tr><td colspan="4" class="text-muted p-3">Aucune commande</td></tr>
{% endfor %}
</tbody>
</table>
</div>
{% endblock %}
