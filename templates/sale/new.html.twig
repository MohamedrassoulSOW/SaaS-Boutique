{% extends 'base.html.twig' %}
{% block title %}Nouvelle vente{% endblock %}
{% block body %}
<h1 class="page-title h3 mb-4">Nouvelle vente</h1>
<form method="post" id="saleForm">
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card stat-card p-3">
            <div class="table-responsive">
            <table class="table align-middle" id="lines">
                <thead><tr><th>Produit</th><th style="width:120px">Qté</th><th style="width:100px"></th></tr></thead>
                <tbody>
                <tr>
                    <td>
                        <select name="product_id[]" class="form-select" required>
                            <option value="">Choisir...</option>
                            {% for p in products %}
                                <option value="{{ p.id }}" data-price="{{ p.salePrice }}" data-stock="{{ p.quantity }}">{{ p.name }} — {{ p.salePrice }} € (stock {{ p.quantity }})</option>
                            {% endfor %}
                        </select>
                    </td>
                    <td><input type="number" min="1" value="1" name="quantity[]" class="form-control" required></td>
                    <td><button type="button" class="btn btn-outline-danger btn-sm" onclick="this.closest('tr').remove()">×</button></td>
                </tr>
                </tbody>
            </table>
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="addLine()">+ Ligne</button>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card stat-card p-3">
            <div class="mb-3">
                <label class="form-label">Client</label>
                <select name="customer_id" class="form-select">
                    <option value="">Comptoir / anonyme</option>
                    {% for c in customers %}<option value="{{ c.id }}">{{ c.fullName }}</option>{% endfor %}
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Remise (€)</label>
                <input type="number" step="0.01" min="0" name="discount" value="0" class="form-control">
            </div>
            <div class="mb-3">
                <label class="form-label">Paiement</label>
                <select name="payment_method" class="form-select">
                    <option value="cash">Espèces</option>
                    <option value="card">Carte</option>
                    <option value="mobile">Mobile</option>
                    <option value="credit">Crédit client</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Montant encaissé (€)</label>
                <input type="number" step="0.01" min="0" name="amount_paid" value="0" class="form-control" placeholder="0 = total">
            </div>
            <button class="btn btn-brand w-100">Encaisser & facturer</button>
        </div>
    </div>
</div>
</form>
<template id="lineTpl">
<tr>
    <td>
        <select name="product_id[]" class="form-select" required>
            <option value="">Choisir...</option>
            {% for p in products %}
                <option value="{{ p.id }}">{{ p.name }} — {{ p.salePrice }} € (stock {{ p.quantity }})</option>
            {% endfor %}
        </select>
    </td>
    <td><input type="number" min="1" value="1" name="quantity[]" class="form-control" required></td>
    <td><button type="button" class="btn btn-outline-danger btn-sm" onclick="this.closest('tr').remove()">×</button></td>
</tr>
</template>
{% endblock %}
{% block javascripts %}
<script>
function addLine(){
  const tpl = document.getElementById('lineTpl');
  document.querySelector('#lines tbody').appendChild(tpl.content.cloneNode(true));
}
</script>
{% endblock %}
