{% extends 'base.html.twig' %}
{% block title %}Contrats{% endblock %}
{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <div class="text-muted small mb-1">Plateforme</div>
        <h1 class="page-title h2 mb-0">Contrats</h1>
        <p class="text-muted mb-0">Tous les contrats existants — discussions, signatures et PDF.</p>
    </div>
    <a href="{{ path('admin_contract_new') }}" class="btn btn-brand">Préparer un contrat</a>
</div>

<div class="panel">
<table class="table mb-0 align-middle">
<thead>
<tr>
    <th>N°</th>
    <th>Entrepreneur</th>
    <th>Entreprise</th>
    <th>Abonnement</th>
    <th>Statut</th>
    <th class="text-center" title="Visibilité"><i class="bi bi-eye" aria-hidden="true"></i><span class="visually-hidden">Visibilité</span></th>
    <th></th>
</tr>
</thead>
<tbody>
{% for c in contracts %}
<tr>
    <td class="fw-semibold">{{ c.number }}</td>
    <td>{{ c.merchant.companyName }}</td>
    <td>{{ c.displayShopName }}</td>
    <td class="small">{{ c.billingPeriodLabel }} · {{ c.price|money }} {{ c.pricePeriodLabel }}</td>
    <td>{{ c.statusLabel }}</td>
    <td class="text-center">
        {% if c.sharedWithMerchant %}
            <span class="visibility-icon is-on" title="Visible par l'entrepreneur">
                <i class="bi bi-eye-fill" aria-hidden="true"></i>
                <span class="visually-hidden">Oui</span>
            </span>
        {% else %}
            <span class="visibility-icon is-off" title="Masqué pour l'entrepreneur">
                <i class="bi bi-eye-slash-fill" aria-hidden="true"></i>
                <span class="visually-hidden">Non</span>
            </span>
        {% endif %}
    </td>
    <td class="text-end text-nowrap">
        <a class="btn btn-sm btn-outline-brand" href="{{ path('admin_contract_show', {id: c.id}) }}">Ouvrir</a>
        {% if c.status != 'signed' %}
            <a class="btn btn-sm btn-outline-brand" href="{{ path('admin_contract_edit', {id: c.id}) }}">Modifier</a>
        {% endif %}
    </td>
</tr>
{% else %}
<tr><td colspan="7" class="text-muted p-4">Aucun contrat</td></tr>
{% endfor %}
</tbody>
</table>
</div>
{% endblock %}
