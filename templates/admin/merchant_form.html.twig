{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}
{% block body %}
<div class="mb-4">
    <div class="text-muted small mb-1">Administration</div>
    <h1 class="page-title h2 mb-1">{{ title }}</h1>
    <p class="text-muted mb-0">
        {% if is_edit %}
            Modifiez les informations de l'entrepreneur, puis enregistrez.
        {% else %}
            Les entrepreneurs ne s'inscrivent plus seuls : vous créez leur accès ici. Ils créeront ensuite les agents.
        {% endif %}
    </p>
</div>
<div class="panel p-4" style="max-width:860px">
    {{ form_start(form) }}
        <h2 class="h5 page-title mb-3">Identité &amp; connexion</h2>
        <div class="row g-2">
            <div class="col-md-6">{{ form_row(form.firstName) }}</div>
            <div class="col-md-6">{{ form_row(form.lastName) }}</div>
            <div class="col-md-6">{{ form_row(form.email) }}</div>
            <div class="col-md-6">{{ form_row(form.phone) }}</div>
            <div class="col-md-6">{{ form_row(form.plainPassword.first) }}</div>
            <div class="col-md-6">{{ form_row(form.plainPassword.second) }}</div>
            {% if form.isActive is defined %}
                <div class="col-md-12">{{ form_row(form.isActive) }}</div>
            {% endif %}
        </div>

        <h2 class="h5 page-title mt-4 mb-3">Entreprise</h2>
        <div class="row g-2">
            <div class="col-md-8">{{ form_row(form.companyName) }}</div>
            <div class="col-md-4">{{ form_row(form.legalForm) }}</div>
            <div class="col-md-6">{{ form_row(form.taxId) }}</div>
            <div class="col-md-6">{{ form_row(form.registrationNumber) }}</div>
            <div class="col-md-12">{{ form_row(form.representativeTitle) }}</div>
            <div class="col-md-12">{{ form_row(form.address) }}</div>
            <div class="col-md-6">{{ form_row(form.city) }}</div>
            <div class="col-md-6">{{ form_row(form.country) }}</div>
            <div class="col-md-6">{{ form_row(form.plan) }}</div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-brand">{{ is_edit ? 'Enregistrer' : 'Créer le compte' }}</button>
            <a class="btn btn-outline-brand" href="{{ path('admin_merchants') }}">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
