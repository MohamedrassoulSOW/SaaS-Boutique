############################################################
# Copier sur le serveur :  cp .env.prod.local.example .env.prod.local
# Ne JAMAIS committer ce fichier (déjà dans .gitignore)
############################################################

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
# Générer : php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=CHANGEZ_MOI_32_OCTETS_HEX
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://ndamstore.sowcoder.com
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Adapter user / mot de passe / nom de base MySQL de l'hébergeur
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/NDAMSTORE_DB?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Hostinger Email — IMPORTANT : encoder le mot de passe pour l’URL
#   @ → %40   # → %23   : → %3A   / → %2F   espace → %20   + → %2B
# SSL 465 (recommandé) :
MAILER_DSN=smtps://contact%40ndamstore.sowcoder.com:VOTRE_MOT_DE_PASSE@smtp.hostinger.com:465
# STARTTLS 587 (si 465 échoue) :
# MAILER_DSN=smtp://contact%40ndamstore.sowcoder.com:VOTRE_MOT_DE_PASSE@smtp.hostinger.com:587
MAIL_FROM="NdamStore <contact@ndamstore.sowcoder.com>"
MAIL_ENVELOPE_SENDER=contact@ndamstore.sowcoder.com
###< symfony/mailer ###

###> plateforme ###
PLATFORM_NAME=NdamStore
PLATFORM_LEGAL_NAME="NdamStore SARL"
PLATFORM_ADDRESS="Immeuble Horizon, Avenue Cheikh Anta Diop"
PLATFORM_CITY=Dakar
PLATFORM_COUNTRY=Sénégal
# Remplacer par le vrai NINEA avant ouverture publique
PLATFORM_TAX_ID="SN-NINEA-REMPLACER"
PLATFORM_EMAIL=contact@ndamstore.sowcoder.com
PLATFORM_PHONE="+221 77 790 14 60"
PLATFORM_PHONE_ALT="+212 684 088765"
PLATFORM_REPRESENTATIVE="Directeur Général"
###< plateforme ###

TRUSTED_PROXIES=REMOTE_ADDR
