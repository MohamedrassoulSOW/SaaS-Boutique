{% extends 'base.html.twig' %}
{% block title %}{{ customer.fullName }}{% endblock %}
{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <h1 class="page-title h3 mb-0">{{ customer.fullName }}</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_customer_edit', {id: customer.id}) }}">Modifier</a>
        <a class="btn btn-outline-brand btn-sm" href="{{ path('app_customer_debts') }}">Crédits</a>
    </div>
</div>
<div class="row g-3 mb-3">
    <div class="col-lg-7">
        <div class="panel p-3">
            <p class="mb-1"><strong>Tél.</strong> {{ customer.phone ?: '—' }}
                {% if customer.phone %}
                    <a class="btn btn-sm btn-outline-brand ms-2" target="_blank" rel="noopener"
                       href="https://wa.me/{{ customer.phone|replace({' ': '', '+': '', '-': ''}) }}?text={{ ('Bonjour '~customer.fullName~', votre solde est de '~(customer.balance|money)~'. Merci.')|url_encode }}">WhatsApp</a>
                {% endif %}
            </p>
            <p class="mb-1"><strong>Email</strong> {{ customer.email ? ('<a href="mailto:'~customer.email~'">'~customer.email~'</a>')|raw : '—' }}</p>
            <p class="mb-0"><strong>Adresse</strong> {{ customer.address ?: '—' }}</p>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="stat-card p-3 h-100">
            <div class="stat-label">Solde dû</div>
            <div class="stat-value">{{ customer.balance|money }}</div>
            {% if customer.balance > 0 %}
            <form method="post" action="{{ path('app_customer_pay', {id: customer.id}) }}" class="mt-3 row g-2 align-items-end">
                <input type="hidden" name="_token" value="{{ csrf_token('customer_pay' ~ customer.id) }}">
                <div class="col-7">
                    <label class="form-label small" for="payAmount">Encaisser un paiement</label>
                    <input type="number" min="1" step="1" max="{{ customer.balance }}" class="form-control" id="payAmount" name="amount" value="{{ customer.balance|round(0) }}" required>
                </div>
                <div class="col-5">
                    <button class="btn btn-brand w-100">Valider</button>
                </div>
            </form>
            {% endif %}
        </div>
    </div>
</div>
<div class="panel">
    <div class="panel-head"><h2>Historique des achats</h2></div>
    <div class="table-responsive">
    <table class="table mb-0">
    <thead><tr><th>Réf.</th><th>Date</th><th>Paiement</th><th>Total</th></tr></thead>
    <tbody>
    {% for s in customer.sales %}
    <tr>
        <td><a href="{{ path('app_sale_show', {id: s.id}) }}">{{ s.reference }}</a></td>
        <td>{{ s.soldAt|date('d/m/Y H:i') }}</td>
        <td>{{ s.paymentMethod }}{% if s.status == 'cancelled' %} · <span class="badge-stock">annulée</span>{% endif %}</td>
        <td>{{ s.total|money }}</td>
    </tr>
    {% else %}
    <tr><td colspan="4" class="text-muted p-3">Aucun achat</td></tr>
    {% endfor %}
    </tbody>
    </table>
    </div>
</div>
{% endblock %}
