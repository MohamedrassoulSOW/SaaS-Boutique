{% extends 'base.html.twig' %}
{% block title %}Fiscalité plateforme{% endblock %}
{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <h1 class="page-title h2 mb-0">Fiscalité plateforme</h1>
        <p class="text-muted mb-0">Identité fiscale de {{ app_name }} et taux TVA par défaut pour les entreprises.</p>
    </div>
</div>

<div class="panel p-4" style="max-width:860px">
    {{ form_start(form) }}
        <h2 class="h5 page-title mb-3">Identité fiscale</h2>
        <div class="row g-2">
            <div class="col-md-8">{{ form_row(form.legalName) }}</div>
            <div class="col-md-4">{{ form_row(form.legalForm) }}</div>
            <div class="col-md-6">{{ form_row(form.taxId) }}</div>
            <div class="col-md-6">{{ form_row(form.registrationNumber) }}</div>
            <div class="col-md-12">{{ form_row(form.address) }}</div>
            <div class="col-md-6">{{ form_row(form.city) }}</div>
            <div class="col-md-6">{{ form_row(form.country) }}</div>
            <div class="col-md-6">{{ form_row(form.email) }}</div>
            <div class="col-md-6">{{ form_row(form.phone) }}</div>
        </div>

        <h2 class="h5 page-title mt-4 mb-3">TVA</h2>
        <div class="row g-2">
            <div class="col-md-6">{{ form_row(form.defaultVatRate) }}</div>
            <div class="col-md-12">{{ form_row(form.defaultPricesIncludeTax) }}</div>
            <div class="col-md-12">{{ form_row(form.taxOnSubscriptions) }}</div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-brand">Enregistrer</button>
            <a class="btn btn-outline-brand" href="{{ path('admin_dashboard') }}">Retour</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
