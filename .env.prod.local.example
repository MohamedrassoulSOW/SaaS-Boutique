# Copier ce fichier en `.env.prod.local` sur le serveur de production
# (ne jamais le committer — déjà ignoré via .env.*.local)
#
# 1. Créez la boîte contact@ndamstore.sowcoder.com dans cPanel / hébergeur
# 2. Récupérez le serveur SMTP (souvent mail.sowcoder.com)
# 3. Remplacez VOTRE_MOT_DE_PASSE (caractères spéciaux → URL-encodés)
#    Ex. @ → %40   # → %23   : → %3A   / → %2F   espace → %20
#
# Option A — SSL implicite (port 465) :
MAILER_DSN=smtps://contact%40ndamstore.sowcoder.com:VOTRE_MOT_DE_PASSE@mail.sowcoder.com:465
#
# Option B — STARTTLS (port 587) si 465 est bloqué :
# MAILER_DSN=smtp://contact%40ndamstore.sowcoder.com:VOTRE_MOT_DE_PASSE@mail.sowcoder.com:587
#
MAIL_FROM="NdamStore <contact@ndamstore.sowcoder.com>"
PLATFORM_EMAIL=contact@ndamstore.sowcoder.com
#
# URL publique du site (liens dans les emails)
# DEFAULT_URI=https://ndamstore.sowcoder.com
