{% extends 'base.html.twig' %}
{% block title %}Fournisseurs{% endblock %}
{% block body %}
<div class="d-flex justify-content-between mb-4">
    <h1 class="page-title h3 mb-0">Fournisseurs</h1>
    <a href="{{ path('app_supplier_new') }}" class="btn btn-brand">Ajouter</a>
</div>
<div class="card stat-card">
<table class="table mb-0 align-middle">
<thead><tr><th>Nom</th><th>Téléphone</th><th>Email</th><th></th></tr></thead>
<tbody>
{% for s in suppliers %}
<tr>
    <td><a href="{{ path('app_supplier_show', {id: s.id}) }}">{{ s.name }}</a></td>
    <td>{{ s.phone }}</td>
    <td>{{ s.email }}</td>
    <td class="text-end">
        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_supplier_edit', {id: s.id}) }}">Modifier</a>
        <form class="d-inline" method="post" action="{{ path('app_supplier_delete', {id: s.id}) }}" data-confirm="Supprimer ce fournisseur ?" data-confirm-title="Supprimer le fournisseur" data-confirm-label="Supprimer">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ s.id) }}">
            <button class="btn btn-sm btn-outline-danger">Suppr.</button>
        </form>
    </td>
</tr>
{% else %}
<tr><td colspan="4" class="text-muted p-4">Aucun fournisseur</td></tr>
{% endfor %}
</tbody>
</table>
</div>
{% endblock %}
