<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    <link rel="icon" href="{{ asset(app_logo) }}" type="image/png">
    <script>
      (function () {
        try {
          var key = 'ndamstore-theme';
          var saved = localStorage.getItem(key) || localStorage.getItem('boutiquesaas-theme');
          var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.setAttribute('data-bs-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
          document.documentElement.setAttribute('data-bs-theme', 'light');
        }
      })();
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650;9..144,700&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="{{ asset('css/app.css') }}?v=33" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body>
{% set flash_payload = [] %}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        {% set flash_payload = flash_payload|merge([{ type: label, message: message }]) %}
    {% endfor %}
{% endfor %}
<script type="application/json" id="flash-data">{{ flash_payload|json_encode|raw }}</script>

{% if app.user %}
{% set route = app.request.attributes.get('_route') %}
<div class="sidebar-backdrop no-print" id="sidebarBackdrop"></div>
<div class="app-shell">
    <aside class="sidebar no-print" id="appSidebar">
        <div class="sidebar-brand">
            <a href="{{ path(is_granted('ROLE_ADMIN') ? 'admin_dashboard' : 'app_dashboard') }}" class="sidebar-brand-link">
                <img src="{{ asset(app_logo) }}" alt="{{ app_name }}" class="brand-logo brand-logo-sidebar">
            </a>
            <div class="tag">{{ app_tagline }}</div>
        </div>

        {% if accessible_shops|length > 1 and not is_granted('ROLE_ADMIN') %}
        <div class="shop-switch mb-3 px-1">
            <label class="form-label small text-white-50 mb-1">Entreprise active</label>
            <select class="form-select form-select-sm" onchange="if(this.value) location.href=this.value">
                {% for shop in accessible_shops %}
                    <option value="{{ path('app_shop_switch', {id: shop.id}) }}" {% if current_shop and current_shop.id == shop.id %}selected{% endif %}>
                        {{ shop.name }}
                    </option>
                {% endfor %}
            </select>
        </div>
        {% endif %}

        <nav class="sidebar-nav">
            {% if is_granted('ROLE_ADMIN') %}
                <div class="nav-section">Plateforme</div>
                <a class="{{ route == 'admin_dashboard' ? 'active' }}" href="{{ path('admin_dashboard') }}"><i class="bi bi-speedometer2"></i>Vue d'ensemble</a>
                <a class="{{ route == 'admin_users' ? 'active' }}" href="{{ path('admin_users') }}"><i class="bi bi-people"></i>Utilisateurs</a>
                <a class="{{ route starts with 'admin_merchant' ? 'active' }}" href="{{ path('admin_merchants') }}"><i class="bi bi-shop-window"></i>Entrepreneurs</a>
                <a class="{{ route starts with 'admin_shop' ? 'active' }}" href="{{ path('admin_shops') }}"><i class="bi bi-shop"></i>Entreprises</a>
                <a class="{{ route starts with 'admin_contract' ? 'active' }}" href="{{ path('admin_contracts') }}"><i class="bi bi-file-earmark-text"></i>Contrats</a>
                <a class="{{ route == 'admin_subscriptions' ? 'active' }}" href="{{ path('admin_subscriptions') }}"><i class="bi bi-credit-card"></i>Abonnements</a>
                <a class="{{ route == 'admin_fiscal' ? 'active' }}" href="{{ path('admin_fiscal') }}"><i class="bi bi-percent"></i>Fiscalité</a>
                <a class="{{ route == 'admin_activity' ? 'active' }}" href="{{ path('admin_activity') }}"><i class="bi bi-journal-text"></i>Journal</a>
            {% else %}
                <div class="nav-section">Pilot</div>
                {% if can_module('dashboard') %}
                <a class="{{ route == 'app_dashboard' ? 'active' }}" href="{{ path('app_dashboard') }}"><i class="bi bi-speedometer2"></i>Tableau de bord</a>
                {% endif %}
                {% if can_module('sales') %}
                <a class="{{ route == 'app_sale_new' ? 'active' }}" href="{{ path('app_sale_new') }}"><i class="bi bi-cart-check"></i>Nouvelle vente</a>
                <a class="{{ route == 'app_sale_index' or route == 'app_sale_show' ? 'active' }}" href="{{ path('app_sale_index') }}"><i class="bi bi-receipt"></i>Ventes</a>
                {% endif %}

                {% if can_module('products_view') or can_module('categories') or can_module('suppliers') or can_module('customers') %}
                <div class="nav-section">Catalogue</div>
                {% if can_module('products_view') %}
                <a class="{{ route starts with 'app_product_' ? 'active' }}" href="{{ path('app_product_index') }}"><i class="bi bi-box-seam"></i>Produits</a>
                {% endif %}
                {% if can_module('categories') %}
                <a class="{{ route starts with 'app_category_' ? 'active' }}" href="{{ path('app_category_index') }}"><i class="bi bi-tags"></i>Catégories</a>
                {% endif %}
                {% if can_module('suppliers') %}
                <a class="{{ route starts with 'app_supplier_' ? 'active' }}" href="{{ path('app_supplier_index') }}"><i class="bi bi-building"></i>Fournisseurs</a>
                {% endif %}
                {% if can_module('customers') %}
                <a class="{{ route starts with 'app_customer_' ? 'active' }}" href="{{ path('app_customer_index') }}"><i class="bi bi-people"></i>Clients</a>
                {% endif %}
                {% endif %}

                {% if can_module('stock') or can_module('purchases') or can_module('inventories') or can_module('reports') or can_module('fiscal') or can_module('shops') %}
                <div class="nav-section">Opérations</div>
                {% if can_module('stock') %}
                <a class="{{ route starts with 'app_stock_' ? 'active' }}" href="{{ path('app_stock_index') }}"><i class="bi bi-clipboard-data"></i>Stock</a>
                {% endif %}
                {% if can_module('purchases') %}
                <a class="{{ route starts with 'app_purchase_' ? 'active' }}" href="{{ path('app_purchase_index') }}"><i class="bi bi-truck"></i>Achats</a>
                {% endif %}
                {% if can_module('inventories') %}
                <a class="{{ route starts with 'app_inventory_' ? 'active' }}" href="{{ path('app_inventory_index') }}"><i class="bi bi-ui-checks-grid"></i>Inventaires</a>
                {% endif %}
                {% if can_module('reports') %}
                <a class="{{ route == 'app_report_index' ? 'active' }}" href="{{ path('app_report_index') }}"><i class="bi bi-graph-up"></i>Rapports</a>
                <a class="{{ route starts with 'app_audit_' ? 'active' }}" href="{{ path('app_audit_index') }}"><i class="bi bi-journal-text"></i>Journal d'audit</a>
                {% endif %}
                {% if can_module('fiscal') %}
                <a class="{{ route starts with 'app_fiscal_' ? 'active' }}" href="{{ path('app_fiscal_index') }}"><i class="bi bi-percent"></i>Impôts</a>
                {% endif %}
                {% if can_module('shops') %}
                <a class="{{ route starts with 'app_shop_' ? 'active' }}" href="{{ path('app_shop_index') }}"><i class="bi bi-shop"></i>Entreprises</a>
                {% endif %}
                {% endif %}

                {% if is_granted('ROLE_MERCHANT') %}
                <div class="nav-section">Compte</div>
                <a class="{{ route starts with 'app_staff_' ? 'active' }}" href="{{ path('app_staff_index') }}"><i class="bi bi-person-badge"></i>Vendeurs</a>
                <a class="{{ route starts with 'app_contract_' or route starts with 'app_shop_contract' ? 'active' }}" href="{{ path('app_dashboard') }}#contrats"><i class="bi bi-file-earmark-text"></i>Contrats</a>
                {% endif %}
            {% endif %}
        </nav>

        <div class="sidebar-foot">
            <a class="{{ route == 'app_notifications' ? 'active' }}" href="{{ path('app_notifications') }}">
                <i class="bi bi-bell"></i>Notifications
                {% if unread_notifications %}<span class="badge-soft">{{ unread_notifications }}</span>{% endif %}
            </a>
            <a class="{{ route == 'app_profile' ? 'active' }}" href="{{ path('app_profile') }}"><i class="bi bi-person"></i>Profil</a>
            <a href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right"></i>Déconnexion</a>
            {% if not is_granted('ROLE_ADMIN') and not is_granted('ROLE_MERCHANT') %}
            <div class="sidebar-credit">Réalisé par <a href="https://sowcoder.com/" target="_blank" rel="noopener noreferrer">SowCoder</a></div>
            {% endif %}
        </div>
    </aside>

    <main class="content-wrap">
        <div class="topbar no-print">
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="mobile-toggle" id="sidebarToggle" aria-label="Menu">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <div class="d-none d-md-block topbar-meta">
                    {% if current_shop and not is_granted('ROLE_ADMIN') %}
                        {{ current_shop.name }}
                        {% if member_role_label and not is_granted('ROLE_MERCHANT') %}
                            <span class="text-muted">· {{ member_role_label }}</span>
                        {% endif %}
                    {% else %}
                        {{ app.user.fullName }}
                    {% endif %}
                </div>
            </div>
            <div class="d-flex align-items-center flex-wrap gap-2">
                <a href="{{ path('app_home') }}" class="btn btn-outline-brand btn-sm">
                    <i class="bi bi-globe me-1"></i><span class="d-none d-sm-inline">Retour au site</span>
                </a>
                {% block topbar_actions %}{% endblock %}
                {% if not is_granted('ROLE_ADMIN') and can_module('sales') and route != 'app_sale_new' %}
                    <a href="{{ path('app_sale_new') }}" class="btn btn-brand btn-sm d-none d-sm-inline-flex">
                        <i class="bi bi-plus-lg me-1"></i>Vente
                    </a>
                {% endif %}
                <button type="button" class="btn btn-outline-brand btn-sm theme-toggle" id="themeToggle" data-theme-toggle aria-label="Basculer le thème" title="Mode clair / sombre">
                    <i class="bi bi-sun-fill theme-icon-sun" aria-hidden="true"></i>
                    <i class="bi bi-moon-stars-fill theme-icon-moon" aria-hidden="true"></i>
                </button>
                <a href="{{ path('app_profile') }}" class="btn btn-outline-brand btn-sm">
                    <i class="bi bi-person me-1"></i>{{ app.user.firstName }}
                </a>
            </div>
        </div>

        <div class="reveal">
            {% block body %}{% endblock %}
        </div>
    </main>
</div>
{% else %}
    {% block auth_body %}{% endblock %}
{% endif %}

<div id="toastStack" class="no-print" aria-live="polite" aria-atomic="true"></div>

<div class="modal fade no-print" id="appConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5 mb-0" id="appConfirmTitle">Confirmation</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0" id="appConfirmMessage">Confirmer cette action ?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="appConfirmCancel" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-danger" id="appConfirmOk">Confirmer</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="{{ asset('js/app.js') }}?v=2"></script>
<script>
(() => {
  // Thème clair/sombre — indépendant du cache de app.js
  const KEY = 'ndamstore-theme';
  const root = document.documentElement;

  const getTheme = () => (root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');

  const syncButtons = () => {
    const dark = getTheme() === 'dark';
    document.querySelectorAll('[data-theme-toggle], #themeToggle, .theme-toggle').forEach((btn) => {
      btn.setAttribute('aria-label', dark ? 'Activer le mode clair' : 'Activer le mode sombre');
      btn.title = dark ? 'Mode clair' : 'Mode sombre';
    });
  };

  const setTheme = (theme) => {
    root.setAttribute('data-theme', theme);
    root.setAttribute('data-bs-theme', theme);
    try { localStorage.setItem(KEY, theme); } catch (_) {}
    syncButtons();
  };

  document.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-theme-toggle], #themeToggle, .theme-toggle');
    if (!btn) return;
    e.preventDefault();
    setTheme(getTheme() === 'dark' ? 'light' : 'dark');
  });

  syncButtons();

  const sidebar = document.getElementById('appSidebar');
  const backdrop = document.getElementById('sidebarBackdrop');
  const toggle = document.getElementById('sidebarToggle');
  if (sidebar && toggle && backdrop) {
    const close = () => { sidebar.classList.remove('open'); backdrop.classList.remove('show'); };
    toggle.addEventListener('click', () => {
      sidebar.classList.toggle('open');
      backdrop.classList.toggle('show');
    });
    backdrop.addEventListener('click', close);
  }
})();
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
