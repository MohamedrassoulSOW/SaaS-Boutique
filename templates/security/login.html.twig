{% extends 'base.html.twig' %}

{% block title %}Connexion — {{ app_name }}{% endblock %}

{% block auth_body %}
<div class="auth-theme-bar no-print">
    <button type="button" class="btn btn-outline-brand btn-sm theme-toggle" id="themeToggle" data-theme-toggle aria-label="Basculer le thème" title="Mode clair / sombre">
        <i class="bi bi-sun-fill theme-icon-sun" aria-hidden="true"></i>
        <i class="bi bi-moon-stars-fill theme-icon-moon" aria-hidden="true"></i>
    </button>
</div>
<div class="auth-shell">
    <section class="auth-visual">
        <div>
            <div class="d-flex align-items-center gap-3 mb-4">
                <img src="{{ asset(app_logo) }}" alt="{{ app_name }}" class="brand-logo brand-logo-auth">
            </div>
            <p class="auth-quote">{{ app_tagline }}</p>
            <p class="small opacity-75 mb-0">Pilotez vos ventes, stocks et équipes depuis un seul espace.</p>
        </div>
        <div class="small opacity-75">Entrepreneurs · caissiers · gestionnaires de stock</div>
        <div class="small opacity-75 mt-2">Réalisé par <a href="https://sowcoder.com/" target="_blank" rel="noopener noreferrer" class="link-light text-decoration-underline">SowCoder</a></div>
    </section>

    <section class="auth-panel">
        <div class="auth-card">
            <div class="brand-line text-center">Bon retour</div>
            <p class="text-muted mb-4 text-center">Connectez-vous avec le compte fourni par l'administration ou votre entrepreneur.</p>
            <p class="text-center mb-4"><a href="{{ path('app_home') }}">← Retour au site</a></p>

            <form method="post" id="loginForm">
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" name="_username" value="{{ last_username }}" class="form-control" required autofocus placeholder="vous@entreprise.com">
                </div>
                <div class="mb-3">
                    <label class="form-label">Mot de passe</label>
                    <input type="password" name="_password" class="form-control" required placeholder="••••••••">
                </div>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" name="_remember_me" id="remember_me">
                        <label class="form-check-label" for="remember_me">Se souvenir de moi</label>
                    </div>
                    <a class="small" href="{{ path('app_reset_password_request') }}">Mot de passe oublié</a>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button class="btn btn-brand w-100 mb-3 py-2" type="submit">Se connecter</button>
            </form>
        </div>
    </section>
</div>
{% endblock %}

{% block javascripts %}
{% if error %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  if (window.AppUI) {
    AppUI.toast({{ error.messageKey|trans(error.messageData, 'security')|json_encode|raw }}, 'danger');
  }
});
</script>
{% endif %}
{% endblock %}
