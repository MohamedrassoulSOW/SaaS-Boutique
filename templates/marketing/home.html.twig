{% extends 'marketing/layout.html.twig' %}

{% block body_class %} mkt-has-hero{% endblock %}

{% block title %}{{ app_name }} — {{ app_tagline }}{% endblock %}

{% block content %}
<section class="mkt-hero">
    <div class="mkt-hero-media" aria-hidden="true">
        <img
            src="{{ asset('images/ndamstore-1-2.jpg') }}?v=1"
            alt=""
            width="1200"
            height="800"
        >
    </div>
    <div class="mkt-hero-scrim" aria-hidden="true"></div>
    <div class="mkt-hero-inner mkt-wrap">
        <h1 class="mkt-hero-title reveal-up delay-1">{{ app_tagline }}</h1>
        <p class="mkt-hero-lead reveal-up delay-2">Pilotez ventes, inventaires et équipes multi-entreprises depuis un seul espace pensé pour votre commerce.</p>
        <div class="mkt-hero-actions reveal-up delay-3">
            <a class="mkt-btn mkt-btn-primary" href="{{ path('app_contact') }}">Parler à un conseiller</a>
            <a class="mkt-btn mkt-btn-ghost" href="{{ path('app_login') }}">Se connecter</a>
        </div>
    </div>
</section>

<section class="mkt-section">
    <div class="mkt-wrap mkt-split">
        <div class="reveal-up">
            <p class="mkt-kicker">Une plateforme</p>
            <h2 class="mkt-h2">Conçue pour le rythme réel d'une entreprise.</h2>
            <p class="mkt-lead">Ventes multi-articles, stock à jour, factures PDF et comptes agents — sans quitter le comptoir.</p>
        </div>
        <figure class="mkt-photo reveal-up delay-1">
            <img
                src="{{ asset('images/ndamstore-2.jpg') }}?v=1"
                alt="Interface {{ app_name }}"
                width="1200"
                height="800"
            >
        </figure>
    </div>
</section>

<section class="mkt-section mkt-section-tint">
    <div class="mkt-wrap">
        <p class="mkt-kicker reveal-up">Ce que vous gagnez</p>
        <h2 class="mkt-h2 reveal-up delay-1">Trois gestes. Toute votre opération.</h2>
        <ul class="mkt-points">
            <li class="reveal-up delay-1">
                <strong>Vendre vite</strong>
                <span>Caisse multi-lignes, clients optionnels, tickets et factures en FCFA.</span>
            </li>
            <li class="reveal-up delay-2">
                <strong>Garder le stock juste</strong>
                <span>Mouvements, achats, inventaires et alertes de rupture.</span>
            </li>
            <li class="reveal-up delay-3">
                <strong>Diriger l'équipe</strong>
                <span>Rôles caissier, magasinier ou responsable — chaque accès à sa place.</span>
            </li>
        </ul>
    </div>
</section>

<section class="mkt-section">
    <div class="mkt-wrap">
        <p class="mkt-kicker reveal-up">Captures d'écran</p>
        <h2 class="mkt-h2 reveal-up delay-1">Découvrez l'interface</h2>
        <p class="mkt-lead reveal-up delay-2">Un aperçu de ce que vous verrez au quotidien.</p>

        <div class="mkt-shot-row reveal-up">
            <figure class="mkt-shot-img"><img src="{{ asset('images/ndamstore-1.jpg') }}?v=1" alt="Vue d'ensemble" width="1200" height="800" loading="lazy"></figure>
            <div class="mkt-shot-text">
                <h3>Vue d'ensemble</h3>
                <p>Un tableau de bord clair pour suivre vos ventes, stocks et finances en un coup d'œil. Tout est centralisé, rien ne vous échappe.</p>
            </div>
        </div>

        <div class="mkt-shot-row reveal-up">
            <figure class="mkt-shot-img"><img src="{{ asset('images/ndamstore-2.jpg') }}?v=1" alt="Point de vente" width="1200" height="800" loading="lazy"></figure>
            <div class="mkt-shot-text">
                <h3>Point de vente</h3>
                <p>Caisse intuitive et rapide. Recherchez un produit par nom ou code-barres, enregistrez la vente et imprimez le reçu en quelques secondes.</p>
            </div>
        </div>

        <div class="mkt-shot-row reveal-up">
            <figure class="mkt-shot-img"><img src="{{ asset('images/ndamstore-3.jpg') }}?v=1" alt="Gestion des produits" width="1200" height="800" loading="lazy"></figure>
            <div class="mkt-shot-text">
                <h3>Gestion des produits</h3>
                <p>Catalogue complet avec images, prix d'achat et de vente, catégories et suivi des marges. Ajoutez ou modifiez un produit en un instant.</p>
            </div>
        </div>

        <div class="mkt-shot-row reveal-up">
            <figure class="mkt-shot-img"><img src="{{ asset('images/ndamstore-4.jpg') }}?v=1" alt="Rapports et analyses" width="1200" height="800" loading="lazy"></figure>
            <div class="mkt-shot-text">
                <h3>Rapports et analyses</h3>
                <p>Graphiques dynamiques, rapports de ventes par période, par agent ou par produit. Des données claires pour décider plus vite.</p>
            </div>
        </div>

        <div class="mkt-shot-row reveal-up">
            <figure class="mkt-shot-img"><img src="{{ asset('images/ndamstore-1-1.jpg') }}?v=1" alt="Stock et inventaire" width="1200" height="800" loading="lazy"></figure>
            <div class="mkt-shot-text">
                <h3>Stock et inventaire</h3>
                <p>Suivez les entrées, sorties et ajustements en temps réel. Alertes de rupture automatiques pour ne jamais manquer de marchandise.</p>
            </div>
        </div>

        <div class="mkt-shot-row reveal-up">
            <figure class="mkt-shot-img"><img src="{{ asset('images/ndamstore-1-2.jpg') }}?v=1" alt="Gestion des clients" width="1200" height="800" loading="lazy"></figure>
            <div class="mkt-shot-text">
                <h3>Gestion des clients</h3>
                <p>Fiches clients avec historique d'achats, soldes et crédits. Offrez un service personnalisé et fidélisez votre clientèle.</p>
            </div>
        </div>
    </div>
</section>

<section class="mkt-section mkt-cta-band">
    <div class="mkt-wrap reveal-up">
        <h2 class="mkt-h2">Prêt à équiper vos entreprises ?</h2>
        <p class="mkt-lead">Écrivez-nous : on active votre espace entrepreneur et on vous accompagne.</p>
        <a class="mkt-btn mkt-btn-primary" href="{{ path('app_contact') }}">Nous contacter</a>
    </div>
</section>
{% endblock %}

{% block stylesheets %}
<style>
.mkt-shot-row {
    display: grid;
    grid-template-columns: 45% 1fr;
    gap: 2.5rem;
    align-items: center;
    margin-top: 3rem;
}

.mkt-shot-img {
    margin: 0;
    border-radius: .85rem;
    overflow: hidden;
    border: 1px solid var(--mkt-line, #e2eae6);
    background: var(--mkt-surface, #f8faf9);
}
.mkt-shot-img img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform .4s ease;
}
.mkt-shot-row:hover .mkt-shot-img img {
    transform: scale(1.03);
}

.mkt-shot-text h3 {
    font-family: var(--mkt-display);
    font-size: 1.3rem;
    font-weight: 650;
    color: var(--mkt-ink, #13201c);
    margin: 0 0 .6rem;
}
.mkt-shot-text p {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--mkt-muted, #5a6f68);
    margin: 0;
}

@media (max-width: 768px) {
    .mkt-shot-row {
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }
    .mkt-shot-text h3 { font-size: 1.15rem; }
}
</style>
{% endblock %}
