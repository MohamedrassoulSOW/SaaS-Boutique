{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}
{% block body %}
<div class="mb-4">
    <div class="text-muted small mb-1">Administration</div>
    <h1 class="page-title h2 mb-1">{{ title }}</h1>
    <p class="text-muted mb-0">Renseignez la boutique et les informations du commerçant. Un contrat multi-pages sera généré pour impression et signature.</p>
</div>
<div class="panel p-4" style="max-width:860px">
    {{ form_start(form, {attr: {enctype: 'multipart/form-data'}}) }}
        <h2 class="h5 page-title mb-3">1. Commerçant</h2>
        {{ form_row(form.merchant) }}
        <p class="small text-muted">Choisissez le commerçant pour préremplir ses informations, puis vérifiez-les.</p>

        <h2 class="h5 page-title mt-4 mb-3">2. Informations personnelles</h2>
        <div class="row g-2">
            <div class="col-md-6">{{ form_row(form.personFirstName) }}</div>
            <div class="col-md-6">{{ form_row(form.personLastName) }}</div>
            <div class="col-md-6">{{ form_row(form.personPhone) }}</div>
            <div class="col-md-6">{{ form_row(form.personEmail) }}</div>
        </div>

        <h2 class="h5 page-title mt-4 mb-3">3. Informations entreprise</h2>
        <div class="row g-2">
            <div class="col-md-8">{{ form_row(form.companyName) }}</div>
            <div class="col-md-4">{{ form_row(form.legalForm) }}</div>
            <div class="col-md-6">{{ form_row(form.taxId) }}</div>
            <div class="col-md-6">{{ form_row(form.registrationNumber) }}</div>
            <div class="col-md-12">{{ form_row(form.representativeTitle) }}</div>
            <div class="col-md-12">{{ form_row(form.companyAddress) }}</div>
            <div class="col-md-3">{{ form_row(form.postalCode) }}</div>
            <div class="col-md-5">{{ form_row(form.city) }}</div>
            <div class="col-md-4">{{ form_row(form.country) }}</div>
        </div>

        <h2 class="h5 page-title mt-4 mb-3">4. Boutique</h2>
        <div class="row g-2">
            <div class="col-md-12">{{ form_row(form.name) }}</div>
            <div class="col-md-12">{{ form_row(form.address) }}</div>
            <div class="col-md-6">{{ form_row(form.phone) }}</div>
            <div class="col-md-6">{{ form_row(form.email) }}</div>
            <div class="col-md-12">{{ form_row(form.logoFile) }}</div>
        </div>

        <h2 class="h5 page-title mt-4 mb-3">5. Abonnement &amp; contrat</h2>
        <div class="row g-2">
            <div class="col-md-3">{{ form_row(form.plan) }}</div>
            <div class="col-md-3">{{ form_row(form.billingPeriod) }}</div>
            <div class="col-md-3">{{ form_row(form.price) }}</div>
            <div class="col-md-3">{{ form_row(form.durationMonths) }}</div>
        </div>
        <p class="small text-muted mb-0">Rupture immédiate : <strong>15 jours</strong> max (mensuel) ou <strong>1 mois</strong> / 30 jours max (annuel).</p>

        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-brand">Créer et générer le contrat</button>
            <a class="btn btn-outline-brand" href="{{ path('admin_shops') }}">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
