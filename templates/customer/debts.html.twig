{% extends 'base.html.twig' %}
{% block title %}Crédits clients{% endblock %}
{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="page-title h2 mb-0">Clients à crédit</h1>
        <p class="text-muted mb-0">Soldes dus — relancez et enregistrez les paiements.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-brand" href="{{ path('app_report_export_credits') }}">Export CSV</a>
        <a class="btn btn-outline-secondary" href="{{ path('app_customer_index') }}">Tous les clients</a>
    </div>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Client</th><th>Téléphone</th><th>Email</th><th>Solde dû</th><th></th></tr></thead>
            <tbody>
            {% for c in customers %}
                <tr>
                    <td class="fw-semibold"><a href="{{ path('app_customer_show', {id: c.id}) }}">{{ c.fullName }}</a></td>
                    <td>
                        {% if c.phone %}
                            <a href="tel:{{ c.phone }}">{{ c.phone }}</a>
                            <a class="btn btn-sm btn-outline-brand ms-1" rel="noopener"
                               href="https://wa.me/{{ c.phone|replace({' ': '', '+': '', '-': ''}) }}?text={{ ('Bonjour '~c.fullName~', votre solde chez '~shop.name~' est de '~(c.balance|money)~'. Merci de régulariser.')|url_encode }}">WhatsApp</a>
                        {% else %}—{% endif %}
                    </td>
                    <td>{{ c.email ? '<a href="mailto:' ~ c.email ~ '">' ~ c.email ~ '</a>' : '—' }}</td>
                    <td><span class="badge-stock">{{ c.balance|money }}</span></td>
                    <td class="text-end"><a class="btn btn-sm btn-brand" href="{{ path('app_customer_show', {id: c.id}) }}">Encaisser</a></td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-muted p-4">Aucun solde en cours. Parfait.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
