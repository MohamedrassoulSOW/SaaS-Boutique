<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ sale.invoice ? sale.invoice.number : sale.reference }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="p-4" onload="window.print()">
    <h1 class="h4">{{ sale.shop.name }}</h1>
    <p>Facture {{ sale.invoice ? sale.invoice.number : sale.reference }} — {{ sale.soldAt|date('d/m/Y H:i') }}</p>
    <p>Client : {{ sale.customer ? sale.customer.fullName : 'Comptoir' }}</p>
    <table class="table">
        <thead><tr><th>Produit</th><th>Qté</th><th>P.U.</th><th>Total</th></tr></thead>
        <tbody>
        {% for item in sale.items %}
            <tr>
                <td>{{ item.product.name }}</td>
                <td>{{ item.quantity }}</td>
                <td>{{ item.unitPrice|money }}</td>
                <td>{{ item.lineTotal|money }}</td>
            </tr>
        {% endfor %}
        </tbody>
        <tfoot>
            <tr><th colspan="3" class="text-end">Total</th><th>{{ sale.total|money }}</th></tr>
        </tfoot>
    </table>
</body>
</html>
