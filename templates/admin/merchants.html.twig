{% extends 'base.html.twig' %}
{% block title %}Commerçants{% endblock %}
{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <div class="text-muted small mb-1">Plateforme</div>
        <h1 class="page-title h2 mb-0">Commerçants</h1>
        <p class="text-muted mb-0">Comptes créés uniquement par l'administration.</p>
    </div>
    <a href="{{ path('admin_merchant_new') }}" class="btn btn-brand">Nouveau commerçant</a>
</div>
<div class="panel">
<div class="table-responsive">
<table class="table mb-0 align-middle">
<thead>
<tr>
    <th>Entreprise</th>
    <th>Contact</th>
    <th>Boutiques</th>
    <th>Abonnement</th>
    <th>Statut</th>
    <th>Créé</th>
    <th></th>
</tr>
</thead>
<tbody>
{% for m in merchants %}
<tr>
    <td class="fw-semibold">{{ m.companyName }}</td>
    <td>
        {{ m.user ? m.user.fullName : '—' }}
        <div class="small text-muted">{{ m.user ? m.user.email : '' }}</div>
    </td>
    <td>{{ m.shops|length }}</td>
    <td>{{ m.subscription ? m.subscription.plan ~ ' / ' ~ m.subscription.status : '—' }}</td>
    <td>
        {% if m.user and m.user.active %}
            <span class="badge-ok">Actif</span>
        {% else %}
            <span class="badge-stock">Inactif</span>
        {% endif %}
    </td>
    <td>{{ m.createdAt|date('d/m/Y') }}</td>
    <td class="text-end text-nowrap">
        <a class="btn btn-sm btn-outline-brand" href="{{ path('admin_merchant_edit', {id: m.id}) }}">Modifier</a>
        <form class="d-inline" method="post" action="{{ path('admin_merchant_delete', {id: m.id}) }}" data-confirm="Supprimer ce commerçant et toutes ses données (boutiques, ventes…) ?" data-confirm-title="Supprimer le commerçant" data-confirm-label="Supprimer">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_merchant' ~ m.id) }}">
            <button class="btn btn-sm btn-outline-danger">Suppr.</button>
        </form>
    </td>
</tr>
{% else %}
<tr><td colspan="7" class="text-muted p-4">Aucun commerçant</td></tr>
{% endfor %}
</tbody>
</table>
</div>
</div>
{% endblock %}
