{% extends 'base.html.twig' %}
{% block title %}Ventes{% endblock %}
{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <h1 class="page-title h3 mb-0">Ventes</h1>
    <a href="{{ path('app_sale_new') }}" class="btn btn-brand">Nouvelle vente</a>
</div>
<div class="card stat-card">
<div class="table-responsive">
<table class="table mb-0 align-middle">
<thead><tr><th>Réf.</th><th>Date</th><th>Agent</th><th>Client</th><th>Total</th><th>Paiement</th><th></th></tr></thead>
<tbody>
{% for s in sales %}
<tr>
    <td>
        {{ s.reference }}
        {% if s.status == 'cancelled' %}<span class="badge-stock ms-1">Annulée</span>{% endif %}
    </td>
    <td>{{ s.soldAt|date('d/m/Y H:i') }}</td>
    <td>
        {% if s.soldBy %}
            <div class="fw-semibold">{{ s.soldBy.fullName }}</div>
            <div class="small text-muted">{{ s.soldBy.email }}</div>
        {% else %}
            <span class="text-muted">—</span>
        {% endif %}
    </td>
    <td>{{ s.customer ? s.customer.fullName : 'Comptoir' }}</td>
    <td>{{ s.total|money }}</td>
    <td>{{ s.paymentMethod }}</td>
    <td class="text-end">
        <div class="d-flex justify-content-end gap-1 flex-nowrap">
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_sale_show', {id: s.id}) }}">Voir</a>
            {% if can_module('sale_cancel') and s.status != 'cancelled' %}
            <form method="post" action="{{ path('app_sale_cancel', {id: s.id}) }}" data-confirm="Annuler la vente {{ s.reference }} ? Le stock sera rétabli." data-confirm-title="Annuler la vente" data-confirm-label="Annuler la vente">
                <input type="hidden" name="_token" value="{{ csrf_token('sale_cancel' ~ s.id) }}">
                <button class="btn btn-sm btn-outline-danger">Annuler</button>
            </form>
            {% endif %}
        </div>
    </td>
</tr>
{% else %}
<tr><td colspan="7" class="text-muted p-4">Aucune vente</td></tr>
{% endfor %}
</tbody>
</table>
</div>
</div>
{% endblock %}
