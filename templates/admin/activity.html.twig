{% extends 'base.html.twig' %}
{% block title %}Journal{% endblock %}
{% block body %}
<h1 class="page-title h3 mb-4">Journal des activités</h1>
<div class="panel">
<div class="table-responsive">
<table class="table mb-0 align-middle">
<thead>
<tr>
    <th>Date</th>
    <th>Utilisateur</th>
    <th>Boutique</th>
    <th>Action</th>
    <th>Description</th>
</tr>
</thead>
<tbody>
{% for log in logs %}
<tr>
    <td class="text-nowrap">{{ log.createdAt|date('d/m/Y H:i:s') }}</td>
    <td>
        {% if log.user %}
            <div class="fw-semibold">{{ log.user.fullName }}</div>
            <div class="small text-muted">{{ log.user.email }}</div>
        {% else %}
            <span class="text-muted">—</span>
        {% endif %}
    </td>
    <td>{{ log.shop ? log.shop.name : '—' }}</td>
    <td><code class="small">{{ log.action }}</code></td>
    <td>{{ log.description }}</td>
</tr>
{% else %}
<tr><td colspan="5" class="text-muted p-3">Aucune activité</td></tr>
{% endfor %}
</tbody>
</table>
</div>
</div>
{% endblock %}
