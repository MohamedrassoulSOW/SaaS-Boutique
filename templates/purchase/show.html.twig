{% extends 'base.html.twig' %}
{% block title %}{{ order.reference }}{% endblock %}
{% block body %}
<div class="d-flex justify-content-between mb-4">
    <h1 class="page-title h3 mb-0">{{ order.reference }}</h1>
    {% if order.status != 'received' %}
    <form method="post" action="{{ path('app_purchase_receive', {id: order.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('receive' ~ order.id) }}">
        <button class="btn btn-brand">Réceptionner & maj stock</button>
    </form>
    {% endif %}
</div>
<div class="card stat-card p-3 mb-3">
    <div><strong>Fournisseur:</strong> {{ order.supplier.name }}</div>
    <div><strong>Statut:</strong> {{ order.status }}</div>
    <div><strong>Total:</strong> {{ order.total|number_format(2, ',', ' ') }} €</div>
</div>
<div class="card stat-card">
<table class="table mb-0">
<thead><tr><th>Produit</th><th>Qté</th><th>P.U.</th><th>Total</th></tr></thead>
<tbody>
{% for item in order.items %}
<tr>
    <td>{{ item.product.name }}</td>
    <td>{{ item.quantity }}</td>
    <td>{{ item.unitPrice|number_format(2, ',', ' ') }} €</td>
    <td>{{ item.lineTotal|number_format(2, ',', ' ') }} €</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
{% endblock %}
