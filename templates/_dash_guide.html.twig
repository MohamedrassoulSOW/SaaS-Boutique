{# Accès rapide au guide — à inclure sur les dashboards #}
<div class="dash-guide-banner panel dash-section">
    <div class="panel-body d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-start gap-3 min-w-0">
            <div class="dash-guide-icon" aria-hidden="true"><i class="bi bi-book"></i></div>
            <div class="min-w-0">
                <div class="fw-semibold">Guide d'utilisation</div>
                <p class="text-muted small mb-0">
                    Recherche interactive, abréviations et support :
                    <a href="mailto:{{ platform.email }}">{{ platform.email }}</a>
                    · <a href="tel:{{ platform.phone|replace({' ': '', '-': ''}) }}">{{ platform.phone }}</a>
                    {% if platform.phone_alt %}
                    · <a href="tel:{{ platform.phone_alt|replace({' ': '', '-': ''}) }}">{{ platform.phone_alt }}</a>
                    {% endif %}
                </p>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-brand btn-sm" href="{{ path('app_guide') }}" rel="noopener">
                <i class="bi bi-box-arrow-up-right me-1"></i>Ouvrir le guide
            </a>
            <a class="btn btn-outline-brand btn-sm" href="{{ path('app_guide') }}#glossaire" rel="noopener">Abréviations</a>
            <a class="btn btn-outline-brand btn-sm" href="{{ path('app_guide') }}#support" rel="noopener">Support</a>
        </div>
    </div>
</div>
