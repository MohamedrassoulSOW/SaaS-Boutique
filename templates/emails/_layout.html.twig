{# Base layout emails NdamStore — blocks: eyebrow, body, footer_note #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ appName|default('NdamStore') }}{% endblock %}</title>
</head>
<body style="margin:0;padding:0;background:#eef5f2;font-family:Segoe UI,Arial,sans-serif;color:#13201c;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#eef5f2;padding:32px 16px;">
    <tr>
        <td align="center">
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid rgba(19,32,28,.08);">
                <tr>
                    <td style="background:linear-gradient(160deg,#147a6a,#0c5c50);padding:28px 32px;color:#fff;">
                        <div style="font-size:22px;font-weight:700;">{{ appName|default('NdamStore') }}</div>
                        <div style="opacity:.8;font-size:13px;margin-top:4px;">{% block eyebrow %}{% endblock %}</div>
                    </td>
                </tr>
                <tr>
                    <td style="padding:32px;">
                        {% block body %}{% endblock %}
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 32px 28px;font-size:12px;color:#8a9b95;line-height:1.5;">
                        {% block footer_note %}
                            {% if platform is defined and platform.email is defined %}
                                Contact : <a href="mailto:{{ platform.email }}" style="color:#0c5c50;">{{ platform.email }}</a>
                                {% if platform.phone is defined %} · {{ platform.phone }}{% endif %}
                            {% endif %}
                        {% endblock %}
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
