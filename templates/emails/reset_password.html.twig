<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Réinitialisation</title>
</head>
<body style="margin:0;padding:0;background:#eef5f2;font-family:Segoe UI,Arial,sans-serif;color:#13201c;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#eef5f2;padding:32px 16px;">
    <tr>
        <td align="center">
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid rgba(19,32,28,.08);">
                <tr>
                    <td style="background:linear-gradient(160deg,#147a6a,#0c5c50);padding:28px 32px;color:#fff;">
                        <div style="font-size:22px;font-weight:700;">{{ appName }}</div>
                        <div style="opacity:.8;font-size:13px;margin-top:4px;">Réinitialisation du mot de passe</div>
                    </td>
                </tr>
                <tr>
                    <td style="padding:32px;">
                        <p style="margin:0 0 12px;font-size:16px;">Bonjour {{ user.firstName }},</p>
                        <p style="margin:0 0 20px;line-height:1.5;color:#5f726c;">
                            Une demande de réinitialisation de mot de passe a été effectuée pour votre compte.
                            Cliquez sur le bouton ci-dessous pour en choisir un nouveau.
                        </p>
                        <p style="margin:0 0 28px;text-align:center;">
                            <a href="{{ resetUrl }}"
                               style="display:inline-block;background:#0c5c50;color:#fff;text-decoration:none;padding:14px 22px;border-radius:10px;font-weight:600;">
                                Réinitialiser mon mot de passe
                            </a>
                        </p>
                        <p style="margin:0 0 12px;font-size:13px;color:#5f726c;line-height:1.5;">
                            Ce lien expire dans {{ expiresInHours }} heures. Si vous n’êtes pas à l’origine de cette demande, ignorez cet email.
                        </p>
                        <p style="margin:0;font-size:12px;color:#8a9b95;word-break:break-all;">
                            Lien alternatif : {{ resetUrl }}
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
