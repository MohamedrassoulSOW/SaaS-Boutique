# Variables spécifiques à la production (sans secrets).
# Les secrets (DSN avec mot de passe) vont dans `.env.prod.local` (non versionné).

###> symfony/framework-bundle ###
APP_ENV=prod
###< symfony/framework-bundle ###

###> symfony/mailer ###
# Remplacé par .env.prod.local sur le serveur
MAILER_DSN=null://null
MAIL_FROM="NdamStore <contact@ndamstore.sowcoder.com>"
###< symfony/mailer ###

###> plateforme ###
PLATFORM_EMAIL=contact@ndamstore.sowcoder.com
###< plateforme ###
