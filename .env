# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=ac3460ff58983d47929ab9eab1d8ebd3
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# URL de base pour les liens absolus (emails)
DEFAULT_URI=http://127.0.0.1:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite pour démarrer rapidement. Pour MySQL (prod / WAMP) :
# DATABASE_URL="mysql://root:@127.0.0.1:3306/saas_boutique?serverVersion=8.0.32&charset=utf8mb4"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Mailpit (recommandé en local) : https://mailpit.axllent.org  →  http://127.0.0.1:8025
MAILER_DSN=smtp://127.0.0.1:1025
# Alternatives :
# MAILER_DSN=native://default
# MAILER_DSN=smtp://USER:APP_PASSWORD@smtp.gmail.com:587
MAIL_FROM="BoutiqueSaaS <noreply@boutiquesaas.local>"
###< symfony/mailer ###
