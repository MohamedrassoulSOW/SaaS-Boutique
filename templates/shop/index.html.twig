{% extends 'base.html.twig' %}
{% block title %}Boutiques{% endblock %}
{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <div class="text-muted small mb-1">Organisation</div>
        <h1 class="page-title h2 mb-0">Mes boutiques</h1>
        <p class="text-muted mb-0">Les boutiques sont créées par l'administration sur demande.</p>
    </div>
</div>
<div class="row g-3">
{% for shop in shops %}
    <div class="col-md-4">
        <div class="stat-card h-100">
            {% if shop.hasLogo %}
                <img src="{{ path('app_media_shop_logo', {id: shop.id}) }}" alt="" class="mb-2" style="max-height:48px">
            {% endif %}
            <div class="d-flex justify-content-between align-items-start mb-2">
                <h2 class="h5 page-title mb-0">{{ shop.name }}</h2>
                {% if current and current.id == shop.id %}<span class="badge-ok">Active</span>{% endif %}
            </div>
            <p class="text-muted small mb-3">{{ shop.address ?: 'Adresse non renseignée' }}</p>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-brand" href="{{ path('app_shop_switch', {id: shop.id}) }}">Activer</a>
                {% if is_granted('ROLE_MERCHANT') %}
                    <a class="btn btn-sm btn-outline-brand" href="{{ path('app_shop_edit', {id: shop.id}) }}">Modifier</a>
                    {% if shop.contract %}
                        <a class="btn btn-sm btn-outline-brand" href="{{ path('app_shop_contract', {id: shop.id}) }}">Contrat</a>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>
{% else %}
    <div class="col-12">
        <div class="alert alert-info">
            Aucune boutique pour le moment. Contactez l'administrateur pour en faire créer une.
        </div>
    </div>
{% endfor %}
</div>
{% endblock %}
