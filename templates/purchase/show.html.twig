{% extends 'base.html.twig' %}
{% block title %}{{ order.reference }}{% endblock %}
{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <h1 class="page-title h3 mb-1">{{ order.reference }}</h1>
        <p class="text-muted mb-0">
            Statut :
            {% if order.status == 'received' %}<span class="badge-ok">Reçue</span>
            {% elseif order.status == 'partial' %}<span class="badge-stock">Partielle</span>
            {% else %}<span class="badge-stock">{{ order.status }}</span>{% endif %}
        </p>
    </div>
    <a href="{{ path('app_purchase_index') }}" class="btn btn-outline-brand btn-sm">Retour</a>
</div>
<div class="card stat-card p-3 mb-3">
    <div><strong>Fournisseur:</strong> {{ order.supplier.name }}</div>
    <div><strong>Total commande:</strong> {{ order.total|money }}</div>
</div>

{% if order.status != 'received' %}
<form method="post" action="{{ path('app_purchase_receive', {id: order.id}) }}" class="panel mb-3">
    <input type="hidden" name="_token" value="{{ csrf_token('receive' ~ order.id) }}">
    <div class="panel-head">
        <h2>Réception (totale ou partielle)</h2>
        <button class="btn btn-brand btn-sm">Valider la réception</button>
    </div>
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead>
                <tr>
                    <th>Produit</th>
                    <th class="text-end">Commandé</th>
                    <th class="text-end">Déjà reçu</th>
                    <th class="text-end">Reste</th>
                    <th class="text-end" style="width:8rem">À réceptionner</th>
                </tr>
            </thead>
            <tbody>
            {% for item in order.items %}
                <tr>
                    <td>{{ item.product.name }}</td>
                    <td class="text-end">{{ item.quantity }}</td>
                    <td class="text-end">{{ item.receivedQuantity }}</td>
                    <td class="text-end">{{ item.remainingQuantity }}</td>
                    <td class="text-end">
                        <input type="number" class="form-control form-control-sm text-end"
                               name="receive_qty[{{ item.id }}]"
                               min="0" max="{{ item.remainingQuantity }}"
                               value="{{ item.remainingQuantity }}"
                               {% if item.remainingQuantity == 0 %}disabled{% endif %}>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</form>
{% else %}
<div class="panel">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead><tr><th>Produit</th><th>Qté</th><th>Reçu</th><th>P.U.</th><th>Total</th></tr></thead>
            <tbody>
            {% for item in order.items %}
            <tr>
                <td>{{ item.product.name }}</td>
                <td>{{ item.quantity }}</td>
                <td>{{ item.receivedQuantity }}</td>
                <td>{{ item.unitPrice|money }}</td>
                <td>{{ item.lineTotal|money }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}
