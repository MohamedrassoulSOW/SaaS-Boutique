{% extends 'base.html.twig' %}
{% block title %}Boutiques{% endblock %}
{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <div class="text-muted small mb-1">Organisation</div>
        <h1 class="page-title h2 mb-0">Boutiques</h1>
    </div>
    {% if is_granted('ROLE_MERCHANT') or is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_shop_new') }}" class="btn btn-brand">Nouvelle boutique</a>
    {% endif %}
</div>
<div class="row g-3">
{% for shop in shops %}
    <div class="col-md-4">
        <div class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <h2 class="h5 page-title mb-0">{{ shop.name }}</h2>
                {% if current and current.id == shop.id %}<span class="badge-ok">Active</span>{% endif %}
            </div>
            <p class="text-muted small mb-3">{{ shop.address ?: 'Adresse non renseignée' }}</p>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-brand" href="{{ path('app_shop_switch', {id: shop.id}) }}">Activer</a>
                {% if is_granted('ROLE_MERCHANT') or is_granted('ROLE_ADMIN') %}
                    <a class="btn btn-sm btn-outline-brand" href="{{ path('app_shop_edit', {id: shop.id}) }}">Modifier</a>
                {% endif %}
            </div>
        </div>
    </div>
{% else %}
    <div class="col-12"><div class="alert alert-info">Aucune boutique. Créez-en une pour commencer.</div></div>
{% endfor %}
</div>
{% endblock %}
