{% extends 'emails/_layout.html.twig' %}
{% block title %}Réinitialisation — {{ appName }}{% endblock %}
{% block eyebrow %}Réinitialisation du mot de passe{% endblock %}
{% block body %}
<p style="margin:0 0 12px;font-size:16px;">Bonjour {{ user.firstName }},</p>
<p style="margin:0 0 20px;line-height:1.5;color:#5f726c;">
    Une demande de réinitialisation de mot de passe a été effectuée pour votre compte.
    Cliquez sur le bouton ci-dessous pour en choisir un nouveau.
</p>
<p style="margin:0 0 28px;text-align:center;">
    <a href="{{ resetUrl }}"
       style="display:inline-block;background:#0c5c50;color:#fff;text-decoration:none;padding:14px 22px;border-radius:10px;font-weight:600;">
        Réinitialiser mon mot de passe
    </a>
</p>
<p style="margin:0 0 12px;font-size:13px;color:#5f726c;line-height:1.5;">
    Ce lien expire dans {{ expiresInMinutes }} minutes. Si vous n’êtes pas à l’origine de cette demande, ignorez cet email.
</p>
<p style="margin:0;font-size:12px;color:#8a9b95;word-break:break-all;">
    Lien alternatif : {{ resetUrl }}
</p>
{% endblock %}
{% block footer_note %}{% endblock %}
