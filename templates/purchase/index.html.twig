{% extends 'base.html.twig' %}
{% block title %}Achats{% endblock %}
{% block body %}
<div class="d-flex justify-content-between mb-4">
    <h1 class="page-title h3 mb-0">Commandes fournisseurs</h1>
    <a href="{{ path('app_purchase_new') }}" class="btn btn-brand">Nouvelle commande</a>
</div>
<div class="card stat-card">
<table class="table mb-0">
<thead><tr><th>Réf.</th><th>Fournisseur</th><th>Date</th><th>Statut</th><th>Total</th><th></th></tr></thead>
<tbody>
{% for o in orders %}
<tr>
    <td>{{ o.reference }}</td>
    <td>{{ o.supplier.name }}</td>
    <td>{{ o.createdAt|date('d/m/Y') }}</td>
    <td><span class="badge text-bg-secondary">{{ o.status }}</span></td>
    <td>{{ o.total|number_format(2, ',', ' ') }} €</td>
    <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="{{ path('app_purchase_show', {id: o.id}) }}">Voir</a></td>
</tr>
{% else %}
<tr><td colspan="6" class="text-muted p-4">Aucune commande</td></tr>
{% endfor %}
</tbody>
</table>
</div>
{% endblock %}
