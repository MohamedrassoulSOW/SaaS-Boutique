<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    <meta name="application-name" content="{{ app_name }}">
    <meta name="apple-mobile-web-app-title" content="{{ app_name }}">
    <meta property="og:site_name" content="{{ app_name }}">
    <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
    <meta name="description" content="{% block meta_description %}{{ app_name }} — {{ app_tagline }} Gestion multi-entreprises pour entrepreneurs.{% endblock %}">
    <meta name="theme-color" content="#0c5c50" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#121c19" media="(prefers-color-scheme: dark)">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <link rel="manifest" href="{{ asset('manifest.webmanifest') }}">
    <link rel="icon" href="{{ asset('icons/favicon-32.png') }}?v=4" type="image/png" sizes="32x32">
    <link rel="icon" href="{{ asset('icons/favicon-16.png') }}?v=4" type="image/png" sizes="16x16">
    <link rel="icon" href="{{ asset('icons/favicon-48.png') }}?v=4" type="image/png" sizes="48x48">
    <link rel="apple-touch-icon" href="{{ asset('icons/apple-touch-icon.png') }}?v=4">
    <script nonce="{{ csp_nonce }}">
      (function () {
        // Titre navigateur = uniquement NdamStore (évite un ancien onglet / préfixe parasite)
        var pageTitle = document.title || {{ app_name|json_encode|raw }};
        if (/soukexpat|expat-souk|marché mondial/i.test(pageTitle)) {
          document.title = pageTitle
            .replace(/\s*[—\-–]\s*SoukExpat[^—\-–]*/ig, '')
            .replace(/SoukExpat[^—\-–]*\s*[—\-–]\s*/ig, '')
            .replace(/^\s*[—\-–]\s*|\s*[—\-–]\s*$/g, '')
            .trim() || {{ app_name|json_encode|raw }};
        }
        try {
          var key = 'ndamstore-theme';
          var saved = localStorage.getItem(key);
          var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.setAttribute('data-bs-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
          document.documentElement.setAttribute('data-bs-theme', 'light');
        }
      })();
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650;9..144,700&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="{{ asset('css/marketing.css') }}?v=14" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body class="mkt-body{% block body_class %}{% endblock %}">
{% set route = app.request.attributes.get('_route') %}
{% set flash_payload = [] %}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        {% set flash_payload = flash_payload|merge([{ type: label, message: message }]) %}
    {% endfor %}
{% endfor %}
<script type="application/json" id="mkt-flash-data">{{ flash_payload|json_encode|raw }}</script>

<header class="mkt-nav" id="mktNav">
    <a class="mkt-nav-brand" href="{{ path('app_home') }}">
        <img src="{{ asset(app_logo) }}" alt="{{ app_name }}" class="brand-logo brand-logo-nav">
    </a>
    <nav class="mkt-nav-links" id="mktNavLinks">
        <a class="{{ route == 'app_home' ? 'is-active' }}" href="{{ path('app_home') }}">Accueil</a>
        <a class="{{ route == 'app_about' ? 'is-active' }}" href="{{ path('app_about') }}">À propos</a>
        <a class="{{ route == 'app_guide' ? 'is-active' }}" href="{{ path('app_guide') }}">Guide</a>
        <a class="{{ route == 'app_contact' ? 'is-active' }}" href="{{ path('app_contact') }}">Contact</a>
        {% if app.user %}
            <a class="mkt-nav-cta mkt-nav-cta-menu" href="{{ path(app.user.isAdmin ? 'admin_dashboard' : 'app_dashboard') }}">Mon espace</a>
        {% else %}
            <a class="mkt-nav-cta mkt-nav-cta-menu" href="{{ path('app_login') }}">Connexion</a>
        {% endif %}
    </nav>
    <div class="mkt-nav-end">
        <button type="button" class="mkt-theme-toggle" id="mktThemeToggle" data-theme-toggle aria-label="Activer le mode sombre" title="Mode clair / sombre">
            <svg class="mkt-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/>
                <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            <svg class="mkt-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 7 7 0 1 0 20 14.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            </svg>
        </button>
        {% if app.user %}
            <a class="mkt-nav-cta mkt-nav-cta-bar" href="{{ path(app.user.isAdmin ? 'admin_dashboard' : 'app_dashboard') }}">Mon espace</a>
        {% else %}
            <a class="mkt-nav-cta mkt-nav-cta-bar" href="{{ path('app_login') }}">Connexion</a>
        {% endif %}
    </div>
    <button type="button" class="mkt-nav-toggle" id="mktNavToggle" aria-label="Menu" aria-expanded="false">
        <span></span><span></span>
    </button>
</header>

<main>
    {% block content %}{% endblock %}
</main>

<footer class="mkt-footer">
    <div class="mkt-wrap mkt-footer-grid">
        <div>
            <div class="mkt-footer-brand">
                <img src="{{ asset(app_logo) }}" alt="{{ app_name }}" class="brand-logo brand-logo-footer">
            </div>
            <p>{{ app_tagline }}</p>
            <p>Logiciel de gestion pour entreprises et équipes commerciales.</p>
        </div>
        <div>
            <div class="mkt-footer-label">Navigation</div>
            <a href="{{ path('app_home') }}">Accueil</a>
            <a href="{{ path('app_about') }}">À propos</a>
            <a href="{{ path('app_guide') }}">Guide d'utilisation</a>
            <a href="{{ path('app_contact') }}">Contact</a>
            <a href="{{ path('app_legal_terms') }}">CGU</a>
            <a href="{{ path('app_legal_privacy') }}">Confidentialité</a>
            <a href="{{ path('app_legal_mentions') }}">Mentions légales</a>
        </div>
        <div>
            <div class="mkt-footer-label">Contact</div>
            <a href="mailto:{{ platform.email }}">{{ platform.email }}</a>
            <a href="tel:{{ platform.phone|replace({' ': '', '-': ''}) }}">{{ platform.phone }}</a>
            {% if platform.phone_alt %}
            <a href="tel:{{ platform.phone_alt|replace({' ': '', '-': ''}) }}">{{ platform.phone_alt }}</a>
            {% endif %}
            <p>{{ platform.city }}, {{ platform.country }}</p>
        </div>
        <div>
            <div class="mkt-footer-label">Présentation</div>
            <p class="mkt-footer-pres-text">Découvrez {{ app_name }} en détail : vision, fonctionnalités et avenir.</p>
            <a href="{{ path('app_presentation') }}" class="mkt-footer-pres-btn" rel="noopener">
                <i class="bi bi-file-earmark-pdf"></i> Présentation PDF
            </a>
            <a href="{{ path('app_presentation_pptx') }}" class="mkt-footer-pres-btn mkt-footer-pres-btn--pptx">
                <i class="bi bi-file-earmark-ppt"></i> Présentation PowerPoint
            </a>
        </div>
    </div>
    <div class="mkt-wrap mkt-footer-copy">
        <span>© {{ "now"|date('Y') }} {{ platform.legal_name }}. Tous droits réservés.</span>
        <span class="mkt-credit">Réalisé par <a href="https://sowcoder.com/" target="_blank" rel="noopener noreferrer"><strong>SowCoder</strong></a></span>
    </div>
</footer>

<div class="mkt-toasts" id="mktToasts" aria-live="polite"></div>
<script src="{{ asset('js/marketing.js') }}?v=3"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
