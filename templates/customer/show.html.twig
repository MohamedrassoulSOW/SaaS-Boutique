{% extends 'base.html.twig' %}
{% block title %}{{ customer.fullName }}{% endblock %}
{% block body %}
<h1 class="page-title h3 mb-3">{{ customer.fullName }}</h1>
<div class="card stat-card p-3 mb-3">
    <p class="mb-1"><strong>Tél.</strong> {{ customer.phone ?: '—' }}</p>
    <p class="mb-1"><strong>Email</strong> {{ customer.email ?: '—' }}</p>
    <p class="mb-1"><strong>Adresse</strong> {{ customer.address ?: '—' }}</p>
    <p class="mb-0"><strong>Solde</strong> {{ customer.balance|number_format(2, ',', ' ') }} €</p>
</div>
<h2 class="h5">Historique des achats</h2>
<div class="card stat-card">
<table class="table mb-0">
<thead><tr><th>Réf.</th><th>Date</th><th>Total</th></tr></thead>
<tbody>
{% for s in customer.sales %}
<tr>
    <td><a href="{{ path('app_sale_show', {id: s.id}) }}">{{ s.reference }}</a></td>
    <td>{{ s.soldAt|date('d/m/Y H:i') }}</td>
    <td>{{ s.total|number_format(2, ',', ' ') }} €</td>
</tr>
{% else %}
<tr><td colspan="3" class="text-muted p-3">Aucun achat</td></tr>
{% endfor %}
</tbody>
</table>
</div>
{% endblock %}
