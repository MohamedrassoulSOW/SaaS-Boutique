{% extends 'base.html.twig' %}
{% block title %}Produits{% endblock %}
{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <div class="text-muted small mb-1">Catalogue</div>
        <h1 class="page-title h2 mb-0">Produits</h1>
        <p class="text-muted mb-0">Affichage par images pour retrouver facilement chaque article.</p>
    </div>
    {% if can_module('products_manage') %}
    <a href="{{ path('app_product_new') }}" class="btn btn-brand">Ajouter</a>
    {% endif %}
</div>

<form class="panel p-3 mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-md-6"><input class="form-control" name="q" value="{{ q }}" placeholder="Rechercher nom, référence, code-barres..."></div>
        <div class="col-auto form-check">
            <input class="form-check-input" type="checkbox" name="low" value="1" id="low" {% if lowOnly %}checked{% endif %}>
            <label class="form-check-label" for="low">Stock faible</label>
        </div>
        <div class="col-auto"><button class="btn btn-outline-brand">Filtrer</button></div>
    </div>
</form>

{% if products|length > 0 %}
<div class="product-visual-grid">
    {% for p in products %}
    <article class="product-visual-card {% if p.lowStock %}is-low{% endif %}">
        <div class="product-visual-photo">
            {% if p.hasPhoto %}
                <img src="{{ path('app_media_product_photo', {id: p.id}) }}" alt="{{ p.name }}" loading="lazy">
            {% else %}
                <div class="product-visual-placeholder" aria-hidden="true">
                    <i class="bi bi-box-seam"></i>
                </div>
            {% endif %}
            {% if p.lowStock %}
                <span class="product-visual-stock badge-stock">Stock {{ p.quantity }}</span>
            {% else %}
                <span class="product-visual-stock badge-ok">Stock {{ p.quantity }}</span>
            {% endif %}
        </div>
        <div class="product-visual-body">
            <h2 class="product-visual-name">{{ p.name }}</h2>
            {% if p.category %}<div class="product-visual-meta">{{ p.category.name }}</div>{% endif %}
            <div class="product-visual-price">{{ p.salePrice|money }}</div>
            {% if can_module('products_manage') %}
            <div class="product-visual-actions">
                <a class="btn btn-sm btn-outline-brand" href="{{ path('app_product_edit', {id: p.id}) }}">Modifier</a>
                <form method="post" action="{{ path('app_product_delete', {id: p.id}) }}" data-confirm="Supprimer ce produit ?" data-confirm-title="Supprimer le produit" data-confirm-label="Supprimer">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ p.id) }}">
                    <button class="btn btn-sm btn-outline-danger">Suppr.</button>
                </form>
            </div>
            {% endif %}
        </div>
    </article>
    {% endfor %}
</div>
{% else %}
<div class="panel p-4 text-muted">Aucun produit</div>
{% endif %}
{% endblock %}
