{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}
{% block body %}
<div class="mb-4">
    <div class="text-muted small mb-1">Administration</div>
    <h1 class="page-title h2 mb-1">{{ title }}</h1>
    <p class="text-muted mb-0">Remplissez les informations pour générer un contrat à montrer au commerçant lors des discussions.</p>
</div>
<div class="panel p-4" style="max-width:860px">
    {{ form_start(form) }}
        <h2 class="h5 page-title mb-3">Commerçant &amp; boutique</h2>
        {{ form_row(form.merchant) }}
        {{ form_row(form.shop) }}
        <div class="row g-2">
            <div class="col-md-6">{{ form_row(form.proposedShopName) }}</div>
            <div class="col-md-6">{{ form_row(form.proposedShopPhone) }}</div>
            <div class="col-md-8">{{ form_row(form.proposedShopAddress) }}</div>
            <div class="col-md-4">{{ form_row(form.proposedShopEmail) }}</div>
        </div>

        <h2 class="h5 page-title mt-4 mb-3">Conditions commerciales</h2>
        <div class="row g-2">
            <div class="col-md-3">{{ form_row(form.plan) }}</div>
            <div class="col-md-3">{{ form_row(form.billingPeriod) }}</div>
            <div class="col-md-3">{{ form_row(form.price) }}</div>
            <div class="col-md-3">{{ form_row(form.durationMonths) }}</div>
        </div>
        {{ form_row(form.discussionNotes) }}
        {{ form_row(form.sharedWithMerchant) }}

        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-brand">Enregistrer et générer le PDF</button>
            <a class="btn btn-outline-brand" href="{{ path('admin_contracts') }}">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
