{% extends 'base.html.twig' %}
{% block title %}Vente {{ sale.reference }}{% endblock %}
{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4 no-print">
    <h1 class="page-title h3 mb-0">Vente {{ sale.reference }}
        {% if sale.status == 'cancelled' %}<span class="badge-stock ms-2">Annulée</span>{% endif %}
    </h1>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" href="{{ path('app_sale_print', {id: sale.id}) }}">Imprimer</a>
        <a class="btn btn-brand" href="{{ path('app_sale_invoice_pdf', {id: sale.id}) }}">PDF</a>
        {% if can_module('sale_cancel') and sale.status != 'cancelled' %}
        <form method="post" action="{{ path('app_sale_cancel', {id: sale.id}) }}" data-confirm="Annuler cette vente ? Le stock sera rétabli." data-confirm-title="Annuler la vente" data-confirm-label="Annuler la vente">
            <input type="hidden" name="_token" value="{{ csrf_token('sale_cancel' ~ sale.id) }}">
            <button class="btn btn-outline-danger">Annuler</button>
        </form>
        {% endif %}
    </div>
</div>
<div class="card stat-card p-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <div><strong>Entreprise:</strong> {{ sale.shop.name }}</div>
            <div><strong>Client:</strong> {{ sale.customer ? sale.customer.fullName : 'Comptoir' }}</div>
            <div><strong>Date:</strong> {{ sale.soldAt|date('d/m/Y H:i') }}</div>
            <div><strong>Agent:</strong> {{ sale.soldBy ? sale.soldBy.fullName ~ ' (' ~ sale.soldBy.email ~ ')' : '—' }}</div>
        </div>
        <div class="col-md-6 text-md-end">
            <div><strong>Facture:</strong> {{ sale.invoice ? sale.invoice.number : '—' }}</div>
            <div><strong>Paiement:</strong> {{ sale.paymentMethod }}</div>
        </div>
    </div>
    <div class="table-responsive">
    <table class="table mb-0">
        <thead><tr><th>Produit</th><th>Qté</th><th>P.U.</th><th>Total</th></tr></thead>
        <tbody>
        {% for item in sale.items %}
            <tr>
                <td>{{ item.product.name }}</td>
                <td>{{ item.quantity }}</td>
                <td>{{ item.unitPrice|money }}</td>
                <td>{{ item.lineTotal|money }}</td>
            </tr>
        {% endfor %}
        </tbody>
        <tfoot>
            <tr><th colspan="3" class="text-end">Sous-total</th><th>{{ sale.subtotal|money }}</th></tr>
            <tr><th colspan="3" class="text-end">Remise</th><th>{{ sale.discount|money }}</th></tr>
            {% if sale.taxRate > 0 %}
            <tr><th colspan="3" class="text-end">TVA ({{ sale.taxRate }} %)</th><th>{{ sale.taxAmount|money }}</th></tr>
            {% endif %}
            <tr><th colspan="3" class="text-end">Total TTC</th><th>{{ sale.total|money }}</th></tr>
            <tr><th colspan="3" class="text-end">Payé</th><th>{{ sale.amountPaid|money }}</th></tr>
        </tfoot>
    </table>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script nonce="{{ csp_nonce }}">
(() => {
  try {
    const shopId = {{ sale.shop.id }};
    const key = `ndamstore.pos.cart.${shopId}`;
    localStorage.removeItem(key);
    sessionStorage.setItem(key + '.paid', '1');
  } catch (_) {
    /* ignore */
  }

  // Popup « Encaissement validé » : proposer l'annulation immédiate de la vente
  const cancelForm = document.querySelector('form[action*="/cancel"]');
  const resultModal = document.getElementById('appResultModal');
  if (cancelForm && resultModal && window.bootstrap) {
    resultModal.addEventListener('shown.bs.modal', () => {
      if (resultModal.dataset.resultType !== 'success') return;
      const actions = resultModal.querySelector('.modal-body .d-flex');
      if (!actions || actions.querySelector('.js-cancel-sale')) return;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn btn-outline-danger js-cancel-sale';
      btn.innerHTML = '<i class="bi bi-arrow-counterclockwise me-1"></i>Annuler la vente';
      btn.addEventListener('click', () => {
        bootstrap.Modal.getOrCreateInstance(resultModal).hide();
        if (typeof cancelForm.requestSubmit === 'function') {
          cancelForm.requestSubmit();
        } else {
          cancelForm.submit();
        }
      });
      actions.appendChild(btn);
    });
  }
})();
</script>
{% endblock %}
