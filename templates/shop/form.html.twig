{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}
{% block body %}
<h1 class="page-title h3 mb-4">{{ title }}</h1>
<div class="panel p-4" style="max-width:760px">
    {% if shop is defined and shop.hasLogo %}
        <div class="mb-3">
            <div class="text-muted small mb-1">Logo actuel (base de données)</div>
            <img src="{{ path('app_media_shop_logo', {id: shop.id}) }}" alt="" style="max-height:80px;border-radius:8px;display:block;margin:0 auto">
        </div>
    {% endif %}
    {{ form_start(form, {attr: {enctype: 'multipart/form-data'}}) }}
        <h2 class="h5 page-title mb-3">Entreprise</h2>
        <div class="row g-2">
            <div class="col-md-12">{{ form_row(form.name) }}</div>
            <div class="col-md-6">{{ form_row(form.currency) }}</div>
            <div class="col-md-12">{{ form_row(form.address) }}</div>
            <div class="col-md-6">{{ form_row(form.phone) }}</div>
            <div class="col-md-6">{{ form_row(form.email) }}</div>
            <div class="col-md-12">{{ form_row(form.logoFile) }}</div>
        </div>

        <h2 class="h5 page-title mt-4 mb-3">Fiscalité</h2>
        <div class="row g-2">
            <div class="col-md-12">{{ form_row(form.merchantTaxId) }}</div>
            <div class="col-md-12">{{ form_row(form.taxEnabled) }}</div>
            <div class="col-md-6">{{ form_row(form.vatRate) }}</div>
            <div class="col-md-12">{{ form_row(form.pricesIncludeTax) }}</div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-brand">Enregistrer</button>
            <a class="btn btn-outline-secondary" href="#" data-go-back>Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
