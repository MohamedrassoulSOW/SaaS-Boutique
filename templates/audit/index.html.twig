{% extends 'base.html.twig' %}
{% block title %}Journal d'audit{% endblock %}
{% block body %}
<div class="mb-4">
    <div class="text-muted small mb-1">{{ shop.name }}</div>
    <h1 class="page-title h2 mb-1">Journal d'audit</h1>
    <p class="text-muted mb-0">Chaque action (vente, stock, produit, connexion…) est signée par l'utilisateur pour la traçabilité.</p>
</div>
<div class="panel">
<div class="table-responsive">
<table class="table align-middle mb-0">
<thead>
<tr>
    <th>Date</th>
    <th>Utilisateur</th>
    <th>Action</th>
    <th>Détail</th>
    <th>IP</th>
</tr>
</thead>
<tbody>
{% for log in logs %}
<tr>
    <td class="text-nowrap">{{ log.createdAt|date('d/m/Y H:i:s') }}</td>
    <td>
        {% if log.user %}
            <div class="fw-semibold">{{ log.user.fullName }}</div>
            <div class="small text-muted">{{ log.user.email }}</div>
        {% else %}
            <span class="text-muted">—</span>
        {% endif %}
    </td>
    <td><code class="small">{{ log.action }}</code></td>
    <td>{{ log.description }}</td>
    <td class="text-muted small">{{ log.ipAddress ?: '—' }}</td>
</tr>
{% else %}
<tr><td colspan="5" class="text-muted p-4">Aucune activité enregistrée pour cette entreprise.</td></tr>
{% endfor %}
</tbody>
</table>
</div>
</div>
{% endblock %}
