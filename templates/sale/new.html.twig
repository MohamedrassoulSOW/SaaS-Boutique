{% extends 'base.html.twig' %}
{% block title %}Nouvelle vente{% endblock %}

{% block topbar_actions %}
    <a href="{{ path('app_sale_index') }}" class="btn btn-outline-brand btn-sm topbar-icon-btn" title="Historique" aria-label="Historique">
        <i class="bi bi-clock-history" aria-hidden="true"></i>
    </a>
    <button type="button" class="btn btn-brand btn-sm pos-cart-toggle topbar-icon-btn" id="posCartToggle" data-bs-toggle="modal" data-bs-target="#posCartModal" title="Panier" aria-label="Panier">
        <i class="bi bi-cart3" aria-hidden="true"></i>
        <span class="pos-cart-badge js-cart-count">0</span>
    </button>
{% endblock %}

{% block body %}
{% if not openCash %}
<div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <strong>Caisse fermée.</strong> Ouvrez une session de caisse avant d’encaisser.
    </div>
    <a href="{{ path('app_cash_index') }}" class="btn btn-sm btn-brand">Ouvrir la caisse</a>
</div>
{% endif %}
<div class="pos-page">
<form method="post" id="saleForm" class="pos-form">
<input type="hidden" name="_token" value="{{ csrf_token('sale_new') }}">
<div class="pos-layout">
    <section class="pos-catalog panel">
        <div class="panel-head pos-catalog-head">
            <h2>Produits</h2>
            <div class="pos-search-wrap">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" id="posSearch" class="form-control form-control-sm" placeholder="Recherche ou scan code-barres…" autocomplete="off" inputmode="none">
            </div>
        </div>
        <div class="pos-grid" id="posGrid">
            {% for p in products %}
            <button
                type="button"
                class="pos-tile"
                data-id="{{ p.id }}"
                data-name="{{ p.name|e('html_attr') }}"
                data-price="{{ p.salePrice }}"
                data-stock="{{ p.quantity }}"
                data-barcode="{{ (p.barcode ?? '')|e('html_attr') }}"
                data-photo="{% if p.hasPhoto %}{{ path('app_media_product_photo', {id: p.id}) }}{% endif %}"
                data-search="{{ (p.name ~ ' ' ~ (p.reference ?? '') ~ ' ' ~ (p.barcode ?? '') ~ ' ' ~ (p.brand ?? '') ~ ' ' ~ (p.category ? p.category.name : ''))|lower|e('html_attr') }}"
            >
                <span class="pos-tile-photo">
                    {% if p.hasPhoto %}
                        <img src="{{ path('app_media_product_photo', {id: p.id}) }}" alt="{{ p.name }}" loading="lazy">
                    {% else %}
                        <span class="pos-tile-placeholder"><i class="bi bi-box-seam"></i></span>
                    {% endif %}
                </span>
                <span class="pos-tile-name">{{ p.name }}</span>
                {% if p.category or p.brand or p.reference %}
                <span class="pos-tile-meta">
                    {%- if p.category %}{{ p.category.name }}{% endif -%}
                    {%- if p.category and p.brand %} · {% endif -%}
                    {%- if p.brand %}{{ p.brand }}{% endif -%}
                    {%- if (p.category or p.brand) and p.reference %} · {% endif -%}
                    {%- if p.reference %}Réf. {{ p.reference }}{% endif -%}
                </span>
                {% endif %}
                {% if p.barcode %}
                <span class="pos-tile-meta">{{ p.barcode }}</span>
                {% endif %}
                <span class="pos-tile-price">{{ p.salePrice|money }}</span>
                <span class="pos-tile-stock {% if p.lowStock %}is-low{% endif %}">Stock {{ p.quantity }}</span>
            </button>
            {% else %}
            <div class="text-muted p-4">Aucun produit actif</div>
            {% endfor %}
        </div>
    </section>
</div>
<div id="cartFields" class="d-none" aria-hidden="true"></div>
</form>
</div>

<div class="modal fade pos-cart-modal" id="posCartModal" tabindex="-1" aria-labelledby="posCartTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header pos-cart-head">
                <div>
                    <h2 class="modal-title" id="posCartTitle">Panier</h2>
                    <p class="pos-cart-subtitle mb-0"><span class="js-cart-count">0</span> article(s)</p>
                </div>
                <button type="button" class="btn btn-sm btn-outline-brand pos-cart-close" data-bs-dismiss="modal" aria-label="Fermer le panier">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>

            <div class="modal-body pos-cart-body">
                <div class="pos-cart-list" id="cartList">
                    <div class="pos-cart-empty text-muted" id="cartEmpty">
                        <span class="pos-cart-empty-icon"><i class="bi bi-bag-plus"></i></span>
                        <strong>Panier vide</strong>
                        <span>Touchez un produit pour commencer la vente.</span>
                    </div>
                </div>

                <div class="pos-cart-options">
                    <div class="pos-options-title">Paiement</div>
                    <div class="pos-fields">
                        <div class="pos-field pos-field-wide">
                            <label class="form-label" for="posCustomer">Client</label>
                            <select name="customer_id" id="posCustomer" form="saleForm" class="form-select form-select-sm">
                                <option value="">Comptoir</option>
                                {% for c in customers %}<option value="{{ c.id }}">{{ c.fullName }}</option>{% endfor %}
                            </select>
                        </div>
                        <div class="pos-field">
                            <label class="form-label" for="posPayment">Mode</label>
                            <select name="payment_method" id="posPayment" form="saleForm" class="form-select form-select-sm">
                                <option value="cash">Espèces</option>
                                <option value="card">Carte</option>
                                <option value="mobile">Mobile</option>
                                <option value="credit">Crédit</option>
                            </select>
                        </div>
                        <div class="pos-field">
                            <label class="form-label" for="discountInput">Remise</label>
                            <input type="number" step="1" min="0" name="discount" id="discountInput" form="saleForm" value="0" class="form-control form-control-sm" inputmode="numeric">
                        </div>
                        <div class="pos-field">
                            <label class="form-label" for="amountPaid">Encaissé</label>
                            <input type="number" step="1" min="0" name="amount_paid" id="amountPaid" form="saleForm" value="0" class="form-control form-control-sm" placeholder="= total" inputmode="numeric">
                        </div>
                    </div>
                    <div class="pos-totals">
                        <div class="pos-total-row"><span>Sous-total</span><span id="subtotalDisplay">0 FCFA</span></div>
                        <div class="pos-total-row"><span>Remise</span><span id="discountDisplay">0 FCFA</span></div>
                        <div class="pos-total-row {% if not taxConfig.enabled %}d-none{% endif %}" id="taxRow">
                            <span>TVA (<span id="taxRateLabel">{{ taxConfig.rate }}</span> %)</span>
                            <span id="taxDisplay">0 FCFA</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer pos-cart-footer">
                <div class="pos-cart-paybar w-100">
                    <div class="pos-cart-paybar-total">
                        <span>Total{% if taxConfig.enabled %} TTC{% endif %}</span>
                        <strong id="totalDisplay">0 FCFA</strong>
                    </div>
                    <button class="btn btn-brand pos-checkout-btn" type="button" id="posCheckoutBtn">
                        <i class="bi bi-cash-coin me-1"></i>Encaisser
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(() => {
  const money = (n) => new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 }).format(Math.round(n || 0)) + ' FCFA';
  const cart = new Map();
  const cartList = document.getElementById('cartList');
  const cartEmpty = document.getElementById('cartEmpty');
  const cartFields = document.getElementById('cartFields');
  const discountInput = document.getElementById('discountInput');
  const customerSelect = document.getElementById('posCustomer');
  const paymentSelect = document.getElementById('posPayment');
  const amountPaidInput = document.getElementById('amountPaid');
  const search = document.getElementById('posSearch');
  const cartModalEl = document.getElementById('posCartModal');
  const saleForm = document.getElementById('saleForm');
  const taxEnabled = {{ taxConfig.enabled ? 'true' : 'false' }};
  const taxRate = {{ taxConfig.rate|default(0) }};
  const pricesIncludeTax = {{ taxConfig.pricesIncludeTax ? 'true' : 'false' }};
  const shopId = {{ current_shop ? current_shop.id : 'null' }};
  const storageKey = shopId ? `ndamstore.pos.cart.${shopId}` : 'ndamstore.pos.cart';

  // Sortir le modal du conteneur animé pour éviter le blocage des clics
  if (cartModalEl && cartModalEl.parentElement !== document.body) {
    document.body.appendChild(cartModalEl);
  }

  const cartModal = cartModalEl && window.bootstrap
    ? bootstrap.Modal.getOrCreateInstance(cartModalEl, { backdrop: true, keyboard: true, focus: true })
    : null;

  function openCart() { cartModal?.show(); }
  function closeCart() { cartModal?.hide(); }

  cartModalEl?.addEventListener('hidden.bs.modal', () => {
    document.querySelectorAll('.modal-backdrop').forEach((el) => el.remove());
    document.body.classList.remove('modal-open');
    document.body.style.removeProperty('overflow');
    document.body.style.removeProperty('padding-right');
  });

  function productTileById(id) {
    const want = String(id);
    return [...document.querySelectorAll('.pos-tile')].find((tile) => tile.dataset.id === want) || null;
  }

  function saveCart() {
    try {
      const payload = {
        items: [...cart.values()],
        discount: discountInput?.value || '0',
        customerId: customerSelect?.value || '',
        paymentMethod: paymentSelect?.value || 'cash',
        amountPaid: amountPaidInput?.value || '0',
      };
      localStorage.setItem(storageKey, JSON.stringify(payload));
    } catch (_) {
      /* ignore quota / private mode */
    }
  }

  function clearSavedCart() {
    try {
      localStorage.removeItem(storageKey);
    } catch (_) {
      /* ignore */
    }
  }

  function loadCart() {
    try {
      const raw = localStorage.getItem(storageKey);
      if (!raw) return;
      const data = JSON.parse(raw);
      const items = Array.isArray(data?.items) ? data.items : [];
      cart.clear();
      items.forEach((item) => {
        const id = String(item.id ?? '');
        if (!id) return;
        const tile = productTileById(id);
        const stock = tile
          ? parseInt(tile.dataset.stock || '0', 10)
          : Math.max(0, parseInt(item.stock || '0', 10));
        let qty = Math.max(1, parseInt(item.qty || '0', 10));
        if (stock < 1) return;
        if (qty > stock) qty = stock;
        cart.set(id, {
          id,
          name: tile?.dataset.name || item.name || 'Produit',
          price: parseFloat(tile?.dataset.price || item.price || '0'),
          stock,
          photo: tile?.dataset.photo || item.photo || '',
          qty,
        });
      });
      if (discountInput && data.discount != null) discountInput.value = data.discount;
      if (customerSelect && data.customerId != null) customerSelect.value = data.customerId;
      if (paymentSelect && data.paymentMethod) paymentSelect.value = data.paymentMethod;
      if (amountPaidInput && data.amountPaid != null) amountPaidInput.value = data.amountPaid;
    } catch (_) {
      clearSavedCart();
    }
  }

  function addProduct(tile) {
    const id = tile.dataset.id;
    const stock = parseInt(tile.dataset.stock || '0', 10);
    const existing = cart.get(id);
    if (existing) {
      if (existing.qty >= stock) {
        if (window.AppUI) AppUI.toast('Stock insuffisant pour cet article.', 'warning');
        return;
      }
      existing.qty += 1;
      existing.stock = stock;
    } else {
      if (stock < 1) {
        if (window.AppUI) AppUI.toast('Produit en rupture de stock.', 'warning');
        return;
      }
      cart.set(id, {
        id,
        name: tile.dataset.name,
        price: parseFloat(tile.dataset.price || '0'),
        stock,
        photo: tile.dataset.photo || '',
        qty: 1,
      });
    }
    renderCart();
  }

  function renderCart(persist = true) {
    const items = [...cart.values()];
    cartList.querySelectorAll('.pos-cart-item').forEach((el) => el.remove());
    cartEmpty.style.display = items.length ? 'none' : 'flex';
    cartFields.innerHTML = '';

    let subtotal = 0;
    items.forEach((item) => {
      subtotal += item.price * item.qty;
      const row = document.createElement('div');
      row.className = 'pos-cart-item' + (item.qty > item.stock ? ' is-over' : '');
      row.innerHTML = `
        <div class="pos-cart-photo">
          ${item.photo
            ? `<img src="${item.photo}" alt="">`
            : `<span class="pos-tile-placeholder"><i class="bi bi-box-seam"></i></span>`}
        </div>
        <div class="pos-cart-main">
          <div class="pos-cart-name">${item.name}</div>
          <div class="pos-cart-line">${money(item.price)} <span>· stock ${item.stock}</span></div>
        </div>
        <div class="pos-cart-side">
          <div class="pos-cart-sum">${money(item.price * item.qty)}</div>
          <div class="pos-qty">
            <button type="button" class="pos-qty-btn" data-act="minus" data-id="${item.id}" aria-label="Moins">−</button>
            <span class="pos-qty-val">${item.qty}</span>
            <button type="button" class="pos-qty-btn" data-act="plus" data-id="${item.id}" aria-label="Plus">+</button>
          </div>
        </div>
        <button type="button" class="pos-qty-btn pos-qty-remove" data-act="remove" data-id="${item.id}" aria-label="Retirer"><i class="bi bi-trash3"></i></button>
      `;
      cartList.appendChild(row);

      const pid = document.createElement('input');
      pid.type = 'hidden';
      pid.name = 'product_id[]';
      pid.value = item.id;
      pid.setAttribute('form', 'saleForm');
      const qty = document.createElement('input');
      qty.type = 'hidden';
      qty.name = 'quantity[]';
      qty.value = String(item.qty);
      qty.setAttribute('form', 'saleForm');
      cartFields.appendChild(pid);
      cartFields.appendChild(qty);
    });

    const discount = Math.max(0, parseFloat(discountInput?.value || '0'));
    const afterDiscount = Math.max(0, subtotal - discount);
    let tax = 0;
    let total = afterDiscount;
    if (taxEnabled && taxRate > 0) {
      if (pricesIncludeTax) {
        const net = afterDiscount / (1 + taxRate / 100);
        tax = afterDiscount - net;
        total = afterDiscount;
      } else {
        tax = afterDiscount * taxRate / 100;
        total = afterDiscount + tax;
      }
    }
    document.getElementById('subtotalDisplay').textContent = money(subtotal);
    document.getElementById('discountDisplay').textContent = money(discount);
    const taxDisplay = document.getElementById('taxDisplay');
    if (taxDisplay) taxDisplay.textContent = money(tax);
    document.getElementById('totalDisplay').textContent = money(total);
    const count = String(items.reduce((n, i) => n + i.qty, 0));
    document.querySelectorAll('.js-cart-count').forEach((el) => { el.textContent = count; });
    if (persist) {
      saveCart();
    } else {
      clearSavedCart();
    }
  }

  document.getElementById('posGrid')?.addEventListener('click', (e) => {
    const tile = e.target.closest('.pos-tile');
    if (!tile) return;
    addProduct(tile);
  });

  cartList?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-act]');
    if (!btn) return;
    const item = cart.get(btn.dataset.id);
    if (!item) return;
    if (btn.dataset.act === 'plus') {
      if (item.qty >= item.stock) {
        if (window.AppUI) AppUI.toast('Stock insuffisant.', 'warning');
        return;
      }
      item.qty += 1;
    } else if (btn.dataset.act === 'minus') {
      item.qty -= 1;
      if (item.qty <= 0) cart.delete(item.id);
    } else if (btn.dataset.act === 'remove') {
      cart.delete(item.id);
    }
    renderCart();
  });

  search?.addEventListener('input', () => {
    const q = (search.value || '').trim().toLowerCase();
    document.querySelectorAll('.pos-tile').forEach((tile) => {
      const hay = tile.dataset.search || '';
      tile.hidden = q !== '' && !hay.includes(q);
    });
  });

  search?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    const code = (search.value || '').trim();
    if (!code) return;
    const tiles = [...document.querySelectorAll('.pos-tile')];
    const exact = tiles.find((tile) => (tile.dataset.barcode || '') === code)
      || tiles.find((tile) => (tile.dataset.barcode || '').toLowerCase() === code.toLowerCase())
      || tiles.find((tile) => (tile.dataset.search || '').split(' ').includes(code.toLowerCase()));
    if (exact) {
      addProduct(exact);
      search.value = '';
      tiles.forEach((tile) => { tile.hidden = false; });
      if (window.AppUI) AppUI.toast(`Ajouté : ${exact.dataset.name}`, 'success');
    } else if (window.AppUI) {
      AppUI.toast('Code-barres introuvable.', 'warning');
    }
  });

  discountInput?.addEventListener('input', () => renderCart(true));
  customerSelect?.addEventListener('change', saveCart);
  paymentSelect?.addEventListener('change', saveCart);
  amountPaidInput?.addEventListener('input', saveCart);

  function syncCartFields() {
    if (!cartFields) return;
    cartFields.innerHTML = '';
    [...cart.values()].forEach((item) => {
      const pid = document.createElement('input');
      pid.type = 'hidden';
      pid.name = 'product_id[]';
      pid.value = String(item.id);
      pid.setAttribute('form', 'saleForm');
      const qty = document.createElement('input');
      qty.type = 'hidden';
      qty.name = 'quantity[]';
      qty.value = String(item.qty);
      qty.setAttribute('form', 'saleForm');
      cartFields.appendChild(pid);
      cartFields.appendChild(qty);
    });
  }

  function checkout() {
    if (cart.size === 0) {
      openCart();
      if (window.AppUI) AppUI.toast('Ajoutez au moins un produit.', 'danger');
      return false;
    }
    for (const item of cart.values()) {
      if (item.qty > item.stock) {
        openCart();
        if (window.AppUI) AppUI.toast(`Stock insuffisant pour « ${item.name} ».`, 'warning');
        return false;
      }
    }
    syncCartFields();
    [customerSelect, paymentSelect, discountInput, amountPaidInput].forEach((el) => {
      if (el) el.setAttribute('form', 'saleForm');
    });
    const checkoutBtn = document.getElementById('posCheckoutBtn');
    if (checkoutBtn && !checkoutBtn.disabled) {
      checkoutBtn.disabled = true;
      checkoutBtn.dataset.originalHtml = checkoutBtn.innerHTML;
      checkoutBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Encaissement…';
    }
    closeCart();
    return true;
  }

  saleForm?.addEventListener('submit', (e) => {
    if (!checkout()) {
      e.preventDefault();
      e.stopPropagation();
      const checkoutBtn = document.getElementById('posCheckoutBtn');
      if (checkoutBtn?.dataset.originalHtml) {
        checkoutBtn.disabled = false;
        checkoutBtn.innerHTML = checkoutBtn.dataset.originalHtml;
      }
    }
  });

  document.getElementById('posCheckoutBtn')?.addEventListener('click', () => {
    if (!saleForm) return;
    if (typeof saleForm.requestSubmit === 'function') {
      saleForm.requestSubmit();
    } else if (checkout()) {
      saleForm.submit();
    }
  });

  function resetCheckoutButton() {
    const checkoutBtn = document.getElementById('posCheckoutBtn');
    if (!checkoutBtn) return;
    checkoutBtn.disabled = false;
    if (checkoutBtn.dataset.originalHtml) {
      checkoutBtn.innerHTML = checkoutBtn.dataset.originalHtml;
    } else {
      checkoutBtn.innerHTML = '<i class="bi bi-cash-coin me-1"></i>Encaisser';
    }
  }

  document.addEventListener('app:checkout-retry', () => {
    resetCheckoutButton();
    openCart();
  });

  function emptyCartUi() {
    cart.clear();
    if (discountInput) discountInput.value = '0';
    if (customerSelect) customerSelect.value = '';
    if (paymentSelect) paymentSelect.value = 'cash';
    if (amountPaidInput) amountPaidInput.value = '0';
    clearSavedCart();
    renderCart(false);
  }

  function consumePaidFlag() {
    try {
      if (sessionStorage.getItem(storageKey + '.paid')) {
        sessionStorage.removeItem(storageKey + '.paid');
        return true;
      }
    } catch (_) {
      /* ignore */
    }
    return false;
  }

  // Uniquement retour arrière (bfcache) après une vente — pas au chargement normal
  window.addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    try {
      const paid = consumePaidFlag();
      const raw = localStorage.getItem(storageKey);
      if (paid || !raw) {
        emptyCartUi();
      }
    } catch (_) {
      /* ignore */
    }
  });

  if (consumePaidFlag()) {
    emptyCartUi();
  } else {
    loadCart();
    renderCart(true);
  }
})();
</script>
{% endblock %}
