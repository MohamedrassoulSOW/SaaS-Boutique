{% extends 'base.html.twig' %}
{% block title %}Nouvelle vente{% endblock %}
{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <div class="text-muted small mb-1">Point de vente</div>
        <h1 class="page-title h2 mb-0">Nouvelle vente</h1>
        <p class="text-muted mb-0">Touchez l’image du produit pour l’ajouter au panier.</p>
    </div>
    <a href="{{ path('app_sale_index') }}" class="btn btn-outline-brand">Historique</a>
</div>

<form method="post" id="saleForm">
<div class="pos-layout">
    <section class="pos-catalog panel">
        <div class="panel-head">
            <h2>Choisir un produit</h2>
            <input type="search" id="posSearch" class="form-control form-control-sm" placeholder="Rechercher…" style="max-width:14rem" autocomplete="off">
        </div>
        <div class="pos-grid" id="posGrid">
            {% for p in products %}
            <button
                type="button"
                class="pos-tile"
                data-id="{{ p.id }}"
                data-name="{{ p.name|e('html_attr') }}"
                data-price="{{ p.salePrice }}"
                data-stock="{{ p.quantity }}"
                data-photo="{% if p.hasPhoto %}{{ path('app_media_product_photo', {id: p.id}) }}{% endif %}"
                data-search="{{ (p.name ~ ' ' ~ (p.reference ?? '') ~ ' ' ~ (p.barcode ?? ''))|lower|e('html_attr') }}"
            >
                <span class="pos-tile-photo">
                    {% if p.hasPhoto %}
                        <img src="{{ path('app_media_product_photo', {id: p.id}) }}" alt="" loading="lazy">
                    {% else %}
                        <span class="pos-tile-placeholder"><i class="bi bi-box-seam"></i></span>
                    {% endif %}
                </span>
                <span class="pos-tile-name">{{ p.name }}</span>
                <span class="pos-tile-price">{{ p.salePrice|money }}</span>
                <span class="pos-tile-stock {% if p.lowStock %}is-low{% endif %}">{{ p.quantity }}</span>
            </button>
            {% else %}
            <div class="text-muted p-4">Aucun produit actif</div>
            {% endfor %}
        </div>
    </section>

    <aside class="pos-cart panel">
        <div class="panel-head">
            <h2>Panier</h2>
            <span class="small text-muted" id="lineCount">0 article</span>
        </div>

        <div class="pos-cart-list" id="cartList">
            <div class="pos-cart-empty text-muted" id="cartEmpty">
                <i class="bi bi-hand-index-thumb d-block mb-2 fs-3"></i>
                Touchez une image pour commencer
            </div>
        </div>

        <div id="cartFields" class="d-none" aria-hidden="true"></div>

        <div class="pos-cart-footer">
            <div class="mb-3">
                <label class="form-label">Client <span class="text-muted fw-normal">(optionnel)</span></label>
                <select name="customer_id" class="form-select">
                    <option value="">Comptoir / sans client</option>
                    {% for c in customers %}<option value="{{ c.id }}">{{ c.fullName }}</option>{% endfor %}
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Remise (FCFA)</label>
                <input type="number" step="1" min="0" name="discount" id="discountInput" value="0" class="form-control">
            </div>
            <div class="mb-3">
                <label class="form-label">Paiement</label>
                <select name="payment_method" class="form-select">
                    <option value="cash">Espèces</option>
                    <option value="card">Carte</option>
                    <option value="mobile">Mobile</option>
                    <option value="credit">Crédit client</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Montant encaissé (FCFA)</label>
                <input type="number" step="1" min="0" name="amount_paid" id="amountPaid" value="0" class="form-control" placeholder="0 = total">
            </div>

            <div class="pos-totals mb-3">
                <div class="d-flex justify-content-between small mb-1"><span>Sous-total</span><span id="subtotalDisplay">0 FCFA</span></div>
                <div class="d-flex justify-content-between small mb-2"><span>Remise</span><span id="discountDisplay">0 FCFA</span></div>
                <div class="d-flex justify-content-between fw-semibold fs-5"><span>Total</span><span id="totalDisplay">0 FCFA</span></div>
            </div>

            <button class="btn btn-brand w-100 btn-lg" type="submit">Encaisser</button>
        </div>
    </aside>
</div>
</form>
{% endblock %}

{% block javascripts %}
<script>
(() => {
  const money = (n) => new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 }).format(Math.round(n || 0)) + ' FCFA';
  const cart = new Map(); // id -> {id, name, price, stock, photo, qty}
  const cartList = document.getElementById('cartList');
  const cartEmpty = document.getElementById('cartEmpty');
  const cartFields = document.getElementById('cartFields');
  const discountInput = document.getElementById('discountInput');
  const search = document.getElementById('posSearch');

  function addProduct(tile) {
    const id = tile.dataset.id;
    const stock = parseInt(tile.dataset.stock || '0', 10);
    const existing = cart.get(id);
    if (existing) {
      if (existing.qty >= stock) {
        if (window.AppUI) AppUI.toast('Stock insuffisant pour cet article.', 'warning');
        return;
      }
      existing.qty += 1;
    } else {
      if (stock < 1) {
        if (window.AppUI) AppUI.toast('Produit en rupture de stock.', 'warning');
        return;
      }
      cart.set(id, {
        id,
        name: tile.dataset.name,
        price: parseFloat(tile.dataset.price || '0'),
        stock,
        photo: tile.dataset.photo || '',
        qty: 1,
      });
    }
    renderCart();
  }

  function renderCart() {
    const items = [...cart.values()];
    cartList.querySelectorAll('.pos-cart-item').forEach((el) => el.remove());
    cartEmpty.style.display = items.length ? 'none' : 'block';
    cartFields.innerHTML = '';

    let subtotal = 0;
    items.forEach((item) => {
      subtotal += item.price * item.qty;
      const row = document.createElement('div');
      row.className = 'pos-cart-item' + (item.qty > item.stock ? ' is-over' : '');
      row.innerHTML = `
        <div class="pos-cart-photo">
          ${item.photo
            ? `<img src="${item.photo}" alt="">`
            : `<span class="pos-tile-placeholder"><i class="bi bi-box-seam"></i></span>`}
        </div>
        <div class="pos-cart-info">
          <div class="pos-cart-name">${item.name}</div>
          <div class="pos-cart-line">${money(item.price)} × ${item.qty} = <strong>${money(item.price * item.qty)}</strong></div>
          <div class="pos-qty">
            <button type="button" class="pos-qty-btn" data-act="minus" data-id="${item.id}" aria-label="Moins">−</button>
            <span class="pos-qty-val">${item.qty}</span>
            <button type="button" class="pos-qty-btn" data-act="plus" data-id="${item.id}" aria-label="Plus">+</button>
            <button type="button" class="pos-qty-btn pos-qty-remove" data-act="remove" data-id="${item.id}" aria-label="Retirer">×</button>
          </div>
        </div>
      `;
      cartList.appendChild(row);

      const pid = document.createElement('input');
      pid.type = 'hidden';
      pid.name = 'product_id[]';
      pid.value = item.id;
      const qty = document.createElement('input');
      qty.type = 'hidden';
      qty.name = 'quantity[]';
      qty.value = String(item.qty);
      cartFields.appendChild(pid);
      cartFields.appendChild(qty);
    });

    const discount = Math.max(0, parseFloat(discountInput?.value || '0'));
    const total = Math.max(0, subtotal - discount);
    document.getElementById('subtotalDisplay').textContent = money(subtotal);
    document.getElementById('discountDisplay').textContent = money(discount);
    document.getElementById('totalDisplay').textContent = money(total);
    document.getElementById('lineCount').textContent = items.length + (items.length > 1 ? ' articles' : ' article');
  }

  document.getElementById('posGrid')?.addEventListener('click', (e) => {
    const tile = e.target.closest('.pos-tile');
    if (!tile) return;
    addProduct(tile);
  });

  cartList?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-act]');
    if (!btn) return;
    const item = cart.get(btn.dataset.id);
    if (!item) return;
    if (btn.dataset.act === 'plus') {
      if (item.qty >= item.stock) {
        if (window.AppUI) AppUI.toast('Stock insuffisant.', 'warning');
        return;
      }
      item.qty += 1;
    } else if (btn.dataset.act === 'minus') {
      item.qty -= 1;
      if (item.qty <= 0) cart.delete(item.id);
    } else if (btn.dataset.act === 'remove') {
      cart.delete(item.id);
    }
    renderCart();
  });

  search?.addEventListener('input', () => {
    const q = (search.value || '').trim().toLowerCase();
    document.querySelectorAll('.pos-tile').forEach((tile) => {
      const hay = tile.dataset.search || '';
      tile.hidden = q !== '' && !hay.includes(q);
    });
  });

  discountInput?.addEventListener('input', renderCart);

  document.getElementById('saleForm')?.addEventListener('submit', (e) => {
    if (cart.size === 0) {
      e.preventDefault();
      if (window.AppUI) AppUI.toast('Ajoutez au moins un produit (touchez une image).', 'danger');
    }
  });

  renderCart();
})();
</script>
{% endblock %}
