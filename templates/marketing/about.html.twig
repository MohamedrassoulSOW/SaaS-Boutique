{% extends 'marketing/layout.html.twig' %}

{% block title %}À propos — {{ app_name }}{% endblock %}
{% block meta_description %}Découvrez {{ app_name }} : la plateforme SaaS de gestion multi-entreprises pour entrepreneurs.{% endblock %}

{% block content %}
<section class="mkt-page-hero">
    <div class="mkt-wrap reveal-up">
        <p class="mkt-kicker">À propos</p>
        <h1 class="mkt-page-title">{{ app_name }}</h1>
        <p class="mkt-lead mkt-lead-wide">{{ app_tagline }} Nous construisons un outil de gestion d'entreprise clair, local et opérationnel — pour les entrepreneurs qui veulent piloter sans complexité inutile.</p>
    </div>
</section>

<section class="mkt-section">
    <div class="mkt-wrap mkt-split mkt-split-reverse">
        <figure class="mkt-photo reveal-up">
            <img
                src="{{ asset('images/ndamstore-3.jpg') }}?v=1"
                alt="Interface {{ app_name }}"
                width="1200"
                height="800"
            >
        </figure>
        <div class="reveal-up delay-1">
            <h2 class="mkt-h2">Une équipe, plusieurs points de vente.</h2>
            <p class="mkt-lead">{{ platform.legal_name }} édite une plateforme multi-tenant : chaque entrepreneur dispose de ses entreprises, de ses agents et de ses données — stockées en base, prêtes pour le web et le mobile.</p>
            <p class="mkt-copy">Contrats formels, abonnements mensuels ou annuels, et règles d’accès par rôle : la plateforme accompagne l'entrepreneur du démarrage jusqu’à la montée en charge.</p>
        </div>
    </div>
</section>

<section class="mkt-section mkt-section-tint">
    <div class="mkt-wrap mkt-about-facts">
        <div class="reveal-up">
            <h2 class="mkt-h2">Basée à {{ platform.city }}</h2>
            <p class="mkt-lead">{{ platform.address }} · {{ platform.country }}</p>
        </div>
        <div class="reveal-up delay-1">
            <p class="mkt-copy"><strong>Représentant</strong><br>{{ platform.representative }}</p>
            <p class="mkt-copy"><strong>Contact</strong><br>
                <a href="mailto:{{ platform.email }}">{{ platform.email }}</a><br>
                <a href="tel:{{ platform.phone|replace({' ': '', '-': ''}) }}">{{ platform.phone }}</a>
                {% if platform.phone_alt %} · <a href="tel:{{ platform.phone_alt|replace({' ': '', '-': ''}) }}">{{ platform.phone_alt }}</a>{% endif %}
            </p>
        </div>
    </div>
</section>
{% endblock %}
