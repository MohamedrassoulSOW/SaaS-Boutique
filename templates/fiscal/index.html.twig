{% extends 'base.html.twig' %}
{% block title %}Impôts & fiscalité{% endblock %}
{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <div class="text-muted small mb-1">Entreprise · {{ shop.name }}</div>
        <h1 class="page-title h2 mb-1">Impôts & fiscalité</h1>
        <div class="text-muted">Suivez la TVA collectée et configurez vos paramètres fiscaux.</div>
    </div>
    <a href="{{ path('app_dashboard') }}" class="btn btn-outline-brand">Tableau de bord</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card h-100">
            <div class="stat-label">TVA du mois</div>
            <div class="stat-value">{{ monthSummary.tax|money }}</div>
            <div class="small text-muted mt-1">{{ monthSummary.salesCount }} vente{{ monthSummary.salesCount > 1 ? 's' : '' }}</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card h-100">
            <div class="stat-label">CA TTC du mois</div>
            <div class="stat-value">{{ monthSummary.gross|money }}</div>
            <div class="small text-muted mt-1">HT {{ monthSummary.net|money }}</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card h-100">
            <div class="stat-label">Statut TVA</div>
            <div class="stat-value fs-4">
                {% if taxConfig.enabled %}
                    <span class="badge-ok">Active · {{ taxConfig.rate }}%</span>
                {% else %}
                    <span class="badge-stock">Inactive</span>
                {% endif %}
            </div>
            <div class="small text-muted mt-1">
                Prix {{ taxConfig.pricesIncludeTax ? 'TTC' : 'HT' }}
                {% if shop.vatRate is null %} · taux plateforme {{ platformVatRate }}%{% endif %}
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card h-100">
            <div class="stat-label">NINEA / ID fiscal</div>
            <div class="stat-value fs-5 text-break">{{ merchant and merchant.taxId ? merchant.taxId : '—' }}</div>
            <div class="small text-muted mt-1">Affiché sur les factures</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="panel h-100">
            <div class="panel-head">
                <h2>TVA collectée sur la période</h2>
            </div>
            <div class="panel-body">
                <form method="get" class="row g-2 align-items-end mb-4">
                    <div class="col-sm-4">
                        <label class="form-label small text-muted mb-1" for="fiscalFrom">Du</label>
                        <input type="date" class="form-control" id="fiscalFrom" name="from" value="{{ from|date('Y-m-d') }}">
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label small text-muted mb-1" for="fiscalTo">Au</label>
                        <input type="date" class="form-control" id="fiscalTo" name="to" value="{{ to|date('Y-m-d') }}">
                    </div>
                    <div class="col-sm-4">
                        <button type="submit" class="btn btn-brand w-100">Filtrer</button>
                    </div>
                </form>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="text-muted small">Base HT</div>
                        <div class="fs-4 fw-semibold">{{ periodSummary.net|money }}</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">TVA collectée</div>
                        <div class="fs-4 fw-semibold">{{ periodSummary.tax|money }}</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Total TTC</div>
                        <div class="fs-4 fw-semibold">{{ periodSummary.gross|money }}</div>
                    </div>
                </div>
                <p class="small text-muted mb-0 mt-3">
                    {{ periodSummary.salesCount }} vente{{ periodSummary.salesCount > 1 ? 's' : '' }}
                    du {{ from|date('d/m/Y') }} au {{ to|date('d/m/Y') }}.
                    Montants issus des ventes encaissées (facture / ticket).
                </p>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="panel h-100">
            <div class="panel-head">
                <h2>Historique TVA (6 mois)</h2>
            </div>
            <div class="panel-body">
                <canvas id="taxChart" height="160"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="panel" style="max-width:760px">
    <div class="panel-head">
        <h2>Paramètres fiscaux</h2>
    </div>
    <div class="panel-body">
        <p class="text-muted small mb-3">
            Ces réglages s’appliquent aux prochaines ventes de <strong>{{ shop.name }}</strong>.
            Le NINEA apparaît sur les factures PDF.
        </p>
        {{ form_start(form) }}
            <div class="row g-2">
                <div class="col-12">{{ form_row(form.merchantTaxId) }}</div>
                <div class="col-12">{{ form_row(form.taxEnabled) }}</div>
                <div class="col-md-6">{{ form_row(form.vatRate) }}</div>
                <div class="col-12">{{ form_row(form.pricesIncludeTax) }}</div>
            </div>
            <div class="mt-3 d-flex flex-wrap gap-2">
                <button class="btn btn-brand">Enregistrer</button>
                {% if can_module('shops') %}
                <a class="btn btn-outline-secondary" href="{{ path('app_shop_edit', {id: shop.id}) }}">Fiche entreprise</a>
                {% endif %}
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
const taxCtx = document.getElementById('taxChart');
if (taxCtx) {
  new Chart(taxCtx, {
    type: 'bar',
    data: {
      labels: {{ taxByMonth|map(d => d.label)|json_encode|raw }},
      datasets: [{
        label: 'TVA collectée',
        data: {{ taxByMonth|map(d => d.tax)|json_encode|raw }},
        backgroundColor: 'rgba(20,122,106,.55)',
        borderRadius: 6,
        maxBarThickness: 36
      }]
    },
    options: {
      plugins: { legend: { display: false } },
      scales: {
        y: { beginAtZero: true, grid: { color: 'rgba(19,32,28,.06)' }, ticks: { color: '#5f726c' } },
        x: { grid: { display: false }, ticks: { color: '#5f726c' } }
      }
    }
  });
}
</script>
{% endblock %}
